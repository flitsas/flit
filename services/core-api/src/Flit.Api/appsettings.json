{
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Core": "Host=localhost;Port=5432;Database=flit_dev;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "https://api.flit.co",
    "Audience": "flit-api",
    "TokenLifetimeHours": 12
  },
  "AllowedHosts": "*",
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "DisableAuthentication": false,
    "DefaultSenderEmail": "",
    "DefaultSenderPassword": "",
    "DefaultSenderName": "FLIT Trámites"
  },
  "Procedures": {
    "Features": {
      "DocumentUpload": true
    }
  },
  "Biometrics": {
    "Provider": "mock"
  },
  "Ocr": {
    "Provider": "mock"
  },
  "Anthropic": {
    "BaseUrl": "https://api.anthropic.com",
    "ApiKey": "",
    "Model": "claude-haiku-4-5-20251001",
    "TimeoutSeconds": 60,
    "MaxTokens": 2000
  },
  "Kyverum": {
    "BaseUrl": "https://verify.kyverum.com",
    "ApiKey": "",
    "AuthScheme": "Bearer",
    "TimeoutSeconds": 30,
    "WebhookCallbackUrl": ""
  },
  "Consultations": {
    "DefaultChains": {
      "vehicle_vin": [ "kyverum_runt", "verifik" ],
      "vehicle_plate": [ "kyverum_runt", "verifik" ],
      "conductor": [ "kyverum_runt_conductor", "verifik_conductor" ]
    },
    "FailoverTimeoutMs": 60000
  },
  "Fasecolda": {
    "ByVinBaseUrl": "https://fasecoldaback.quantil.co",
    "ByVinPath": "/api/busquedaVin",
    "ApiBaseUrl": "https://guiadevalores.fasecolda.com/apifasecolda",
    "AuthPath": "/token",
    "ListCodePath": "/api/listacodigosid/consultabycodigo",
    "GrantType": "password",
    "TimeoutSeconds": 55
  },
  "Messaging": {
    "IdentityValidation": "inprocess"
  },
  "FileManager": {
    "BaseUrl": "https://pdnfilemanager.flitsas.online/",
    "FilesPath": "api/v1/files",
    "Category": "tramites",
    "TimeoutSeconds": 120
  },
  "PasswordRecovery": {
    "ResetUrlBase": "https://flitsas.online/reset-password",
    "TokenLifetimeMinutes": 30,
    "MinPasswordLength": 8
  },
  "Invitations": {
    "ActivateUrlBase": "https://flitsas.online/invite/activate"
  },
  "Database": {
    "RunStartupMigrations": false
  },
  "AnalyticsTelemetry": {
    "Enabled": true,
    "RetentionDays": 90
  },
  "TramiteValidations": {
    "DuplicateActiveProcedure": { "Mode": "block" },
    "VehicleRegistrationState": { "Mode": "block" }
  }
}