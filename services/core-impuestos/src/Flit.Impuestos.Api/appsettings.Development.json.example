{
  // core-impuestos en tu máquina (docs/suite/local.md). Copia este archivo a appsettings.Development.json (ignorado por git) y
  // reemplaza cada CAMBIAR. Puertos del plan (docs/impuestos/plan-implementacion.md §0): API 4033, gRPC interno 8089.
  "Urls": "http://127.0.0.1:4033",
  "Servicio": { "GrpcPort": 8089, "MigrateOnStartup": true },
  "ConnectionStrings": {
    // El servicio usa su esquema propio «impuestos» y lo migra al arrancar. En local, la instancia de pruebas 5433.
    "Servicio": "Host=127.0.0.1;Port=5433;Database=CAMBIAR;Username=CAMBIAR;Password=CAMBIAR"
  },
  "Impuestos": {
    // Solo en local: la empresa queda suscrita al producto sin preguntarle a Identidad. Nunca en DEV, QA ni PDN.
    "Identidad": { "SimularSuscripcionActiva": true },
    // Data Protection propio (plan §4.2): .pfx RSA con llave privada, fuera del repo. Sin él el servicio no arranca.
    "DataProtection": {
      "CertificadoRuta": "CAMBIAR-ruta-al-pfx-local",
      "CertificadoClave": "CAMBIAR"
    },
    // API del proveedor (obligatorio al arrancar, M07). En local, el stub scripts/dev/stub-impuestos (8898) y el token que imprime.
    "Api": { "BaseUrl": "http://127.0.0.1:8898", "IntegrationToken": "CAMBIAR-el-que-imprime-el-stub" },
    // Receptor del webhook (M09, guía §2.2): https, sin usuario ni fragmento. http solo en loopback y solo con PermitirHttpLocal=true
    // (apagada por defecto). Sin UrlBase válida las liquidaciones salen sin callbackUrl y se concilian por GET.
    "Avisos": { "UrlBase": "CAMBIAR-https-publica/api/v1/impuestos/avisos", "PermitirHttpLocal": false },
    // M11: los recibos PDF van al file-manager (FileManager:BaseUrl o FILE_MANAGER_BASE_URL, categoría impuestos). Sin él el
    // servicio no arranca, salvo con esta bandera de memoria (solo local y pruebas: los recibos se pierden al reiniciar).
    "Archivos": { "GuardarEnMemoria": true },
    // Sin GatewayUrl el manifiesto no se registra (solo un aviso en el log).
    "Plataforma": { "GatewayUrl": "http://127.0.0.1:4002" }
  },
  "Platform": {
    "Auth": {
      "JwksUri": "http://127.0.0.1:4003/.well-known/jwks.json",
      "Issuers": [ "http://127.0.0.1:4022/" ]
    },
    "ServiceClient": {
      "ClientSecret": "CAMBIAR-igual-a-svc-impuestos-en-core-api",
      "TokenEndpoint": "http://127.0.0.1:4003/connect/token"
    },
    "Messaging": {
      "ConnectionString": "amqp://impuestos:CAMBIAR@127.0.0.1:5672/flit"
    }
  }
}
