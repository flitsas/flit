# FLIT — Plantilla de variables de entorno del frontend (Next.js 16 App Router).
# Copia a `.env.local` para desarrollo local. NO commitear `.env.local` (gitignored).
# En DEV/QA/PDN, las NEXT_PUBLIC_* se hornean en build (ver .github/workflows/cd.yml,
# build-args del job build-frontend) y las server-only se inyectan en docker-compose.prod.yml.

# ============================================================================
# API (existentes)
# ============================================================================
# Base cross-origin del Gateway (api.<env>.flitsas.online/api/v1). Vacía en dev local:
# next.config.ts reescribe /api/v1/* hacia CORE_API_ORIGIN.
NEXT_PUBLIC_API_BASE_URL=

# Origen del core-api al que apuntan los rewrites de dev local (next.config.ts).
CORE_API_ORIGIN=http://localhost:4003

# ============================================================================
# Marca Blanca — HU #12419 (ADR-0060 §D5)
# ============================================================================
# Lista de hosts que se consideran "FLIT" (sin marca de red), separados por comas.
# Soporta comodín "*.dominio", que cubre el dominio raíz y sus subdominios. Sin definir, se usa el respaldo:
# localhost, 127.0.0.1, *.flitsas.online, *.flitsas.com (ver lib/brand/hosts.ts).
# El prefijo "!" excluye un host EXACTO aunque un comodín lo cubra y se evalúa primero: así los
# hosts de prueba de marca blanca (HU #12761) se tratan como dominios de red pese a colgar de
# *.flitsas.online.
NEXT_PUBLIC_FLIT_HOSTS=localhost,127.0.0.1,flitsas.online,*.flitsas.online,flitsas.com,*.flitsas.com,!marcablancadev.flitsas.online,!marcablancaqa.flitsas.online,!marcablancapdn.flitsas.online

# Server-only (SIN prefijo NEXT_PUBLIC_ — nunca se hornea en el bundle del navegador). Base
# interna hacia el Gateway por la red Docker, para resolver la marca en `resolve-brand.server.ts`
# sin pasar por el borde público (evita el hairpin de nginx, mismo patrón que MIGRACION_API_URL).
# Local: http://localhost:4002 · Prod (docker-compose.prod.yml): http://gateway:4002
BRANDING_INTERNAL_API_URL=http://localhost:4002

# Server-only. Clave interna que el Gateway exige (X-Internal-Key) para confiar en el sello
# X-Flit-Domain que envía este servicio — sin ella, el Gateway ignora el sello y la marca cae al
# respaldo FLIT (nunca es un error visible). Debe coincidir con Internal__ApiKey del Gateway.
FLIT_INTERNAL_API_KEY=

# ============================================================================
# DR. FLIT — canales de soporte (HU-F). NEXT_PUBLIC_*: se hornean en build.
# ============================================================================
# Correo y URL de radicación tienen respaldo institucional en código; el TELÉFONO no: sin
# definirlo, la opción «Soporte» del chat no muestra línea de atención.
NEXT_PUBLIC_DR_FLIT_SUPPORT_EMAIL=soporte@flitsas.com
NEXT_PUBLIC_DR_FLIT_SUPPORT_PHONE=
NEXT_PUBLIC_DR_FLIT_SUPPORT_CASE_URL=https://flitsas.com.co/SOPORTE/
