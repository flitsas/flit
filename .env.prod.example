# .env de PRODUCCION (VPS) — copia a `.env` junto a docker-compose.prod.yml.
# NO commitear el .env real. Este .example solo documenta las variables.
#
# Topologia (puerto expuesto == interno). Puertos POR AMBIENTE:
#   Servicio   var               DEV    QA     PDN
#   frontend   FRONTEND_PORT     4001   5001   6001
#   gateway    GATEWAY_PORT      4002   5002   6002
#   core-api   CORE_API_PORT     4003   5003   6003
#   python-ml  PYTHON_ML_PORT    4012   5012   6012
#   migracion  MIGRACION_API_PORT 4030  5030   6030   (solo red interna, no se publica)
# Postgres en el HOST. Este ejemplo usa valores de DEV; ajusta segun el ambiente del VPS.

# ── Base de datos (Postgres del HOST, formato Npgsql .NET — NO la URL postgres://) ──
# Equivale a: postgres://flit:PASSWORD@host.docker.internal:5432/flit_dev?sslmode=disable
CONNECTION_STRING_CORE=Host=host.docker.internal;Port=5432;Database=flit_dev;Username=flit;Password=CAMBIA_ESTA_PASSWORD;SSL Mode=Disable

# ── CORS / dominios ── (el front de ESTE ambiente)
# OBLIGATORIA. Ademas del CORS, es la base de los enlaces de los CORREOS de core-api
# (Bug #13194): activacion de cuenta (/invite/activate), recuperacion de contrasena
# (/reset-password), imagenes del correo (/email-assets) y logos de marca
# (PublicBranding). Si falta, `docker compose` aborta en vez de mandar enlaces a DEV.
# Sin barra final. Valor por ambiente (dominios de cd.yml, front_domain):
#   DEV  https://dev.flitsas.online
#   QA   https://qa.flitsas.online
#   PDN  https://flitsas.online        (NO pdn.flitsas.online: ese host no sirve el stack)
CORS_ORIGIN=https://dev.flitsas.online

# ── Puertos del ambiente ──
# El CD los inyecta automaticamente segun la rama. Fijalos aqui solo para operacion
# manual (docker compose up sin el CD). Valores DEV por defecto:
FRONTEND_PORT=4001
GATEWAY_PORT=4002
CORE_API_PORT=4003
PYTHON_ML_PORT=4012
# migracion-api no publica puerto en el host, pero SI lleva variable: el gateway lo
# alcanza por la red interna y los dos (ASPNETCORE_URLS del servicio + destino de
# migracion-cluster en el gateway) la leen. Si divergen, /admin/migracion da 502.
MIGRACION_API_PORT=4030

# ── Lo que exporta el CD (cd.yml, paso «Deploy via SSH») ──
# El CD las pone solo durante su sesión. Para correr `docker compose` a mano (handoff de la suite) tienen que
# estar aquí con el MISMO valor, o el compose usa los de DEV. FLIT_SUITE_ENV es obligatoria: sin ella el compose
# no arranca (vacía en PDN es válida). Valores DEV; QA: 50xx, `qa`, qa.*; PDN: 60xx, vacía, sin prefijo.
FLIT_SUITE_ENV=dev
FLIT_HUB_URL=https://dev.flitsas.online
FLIT_TRAMITES_URL=https://dev.tramites.flitsas.online
CORE_IDENTITY_PORT=4025
# Epic #13316 (HU #13334): gRPC de Identidad para los demás servicios, solo en la red interna (sin mapeo en ports).
# Vacío = no escucha gRPC. Propuesto 8083, igual en todos los ambientes (docs/despliegue-y-puertos.md §2.d).
# CORE_IDENTITY_GRPC_PORT=8083
HUB_PORT=4022
CORE_ICT_PORT=4020
# Tags: `dev` en DEV, `qa` en QA, `sha-<commit>` en PDN (el que desplegó el CD; `docker ps` lo muestra).
CORE_API_TAG=dev
CORE_IDENTITY_TAG=dev
CORE_ICT_TAG=dev
FRONTEND_TAG=dev
FRONTEND_HUB_TAG=dev
PYTHON_ML_TAG=dev

# ── JWT ──
# No se requieren llaves: core-api crea su llave de firma una vez y la guarda cifrada en
# security.jwt_signing_keys (HU #12896). Valida firma, emisor, audiencia y vencimiento.
# Solo si algo fallara, esta línea vuelve al comportamiento anterior sin redesplegar:
# JWT_VALIDATE_ISSUED_TOKENS=false

# ── Ambiente .NET y atajos de desarrollo (HU #12895, A-02) ──
# Sin estas líneas todo sigue como hoy (Development). Qué depende de cada una:
# docs/suite/frentes/a-inventario-ambientes.md. Para sacar un ambiente de Development:
# FLIT_DOTNET_ENVIRONMENT=Dev
# FLIT_SEED_DEMO_USERS=false        # no crear cuentas demo con contraseña fija
# FLIT_SWAGGER_ENABLED=false        # sin /swagger público
# SMTP_USE_CONSOLE_WHEN_NO_HOST=false
# FLIT_DEV_SEED=true                # solo DEV: las migraciones de datos demo siguen sembrando
# FLIT_SEED_RBAC_CATALOG=true       # dejar siempre en true: roles, módulos y permisos

# ── FLIT Suite: servidor OIDC del hub (HU #12990, A-05) ──
# Apagado por defecto: /connect/* responde 404 y el login de siempre no cambia. Las llaves de firma y
# cifrado se crean solas en la base (security.jwt_signing_keys). El borde debe llevar /connect/* y
# /.well-known/* del host del hub al gateway (o al contenedor frontend-hub, que los reenvía).
# FLIT_OIDC_ENABLED=true
# Cifra la cookie de sesión de @flit/auth (hub y productos). Solo al encender el perfil `suite`.
# Al menos 32 caracteres, distinta en cada ambiente: openssl rand -base64 48
# FLIT_SESSION_SECRET=
# Trámites a su host y el hub a la raíz (A-11): junto con el cambio del borde,
# ver deploy/edge/nginx/flit-suite-hosts.conf.example (orden y cómo volver atrás).
# FLIT_SESSION_MODE=oidc
# FLIT_TRAMITES_HOST_ENABLED=true

# ── Verifik (RUNT) ──
VERIFIK_API_TOKEN=CAMBIA_ESTE_TOKEN
VERIFIK_BASE_URL=https://api.verifik.co
VERIFIK_TIMEOUT_SECONDS=30

# ── SMTP (correo de invitaciones y recuperación de contraseña) ──
# Si se omiten, el backend usará ConsoleEmailSender y el correo NO se enviará.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_DISABLE_AUTH=false
SMTP_FROM=tramitesvehiculos@flitsas.com
SMTP_PASSWORD=CAMBIA_ESTA_PASSWORD
SMTP_FROM_NAME=FLIT Tramites

# ── File Manager (donde V2 lee los binarios de los adjuntos) ──
# Sin esta variable, core-api cae al default de appsettings.json, que apunta al
# file-manager de AWS pdn. Al pasar V2 a MinIO HAY QUE definirla.
# El migrador SUBE a esta misma URL (FLITMIG_TargetFileManager__BaseUrl la reusa):
# si la API y el migrador apuntaran a sitios distintos, los adjuntos migrados
# existirian en la tabla pero no abririan. Falla en silencio.
FILE_MANAGER_BASE_URL=https://CAMBIA_ESTO_file-manager-minio/

# ── Migrador V1 -> V2 (perfil `migracion`, no se levanta solo) ──
# Solo hace falta cuando se va a migrar. Uso:
#   mkdir -p migracion   # intercambio de ids y reportes, montado en /work
#   docker compose -f docker-compose.prod.yml --profile migracion run --rm \
#     migrador --tipo registration --ids-file /work/ids.txt --dry-run
#
# Bases de datos. V1 es SOLO LECTURA: el migrador nunca escribe en el origen.
FLITMIG_V1_SOURCE=Host=CAMBIA_ESTO;Port=5432;Database=CAMBIA_ESTO;Username=CAMBIA_ESTO;Password=CAMBIA_ESTO
# V2 destino: si se omite reutiliza CONNECTION_STRING_CORE (recomendado, es la misma base).
# FLITMIG_V2_TARGET=
#
# Etiqueta del lote: permite auditar y revertir por tanda. UNO DISTINTO POR OLA.
FLITMIG_BATCH_ID=pdn-ola-1
#
# Origen de los binarios de V1 (file-manager de AWS pdn). Lectura: no exige token.
FLITMIG_SOURCE_FM_BASE_URL=https://ny46zhyeti.execute-api.us-east-1.amazonaws.com/pdn/
# FLITMIG_SOURCE_FM_AUTH_TOKEN=
# Escritura en MinIO: rellenar SOLO si el MinIO de produccion exige autenticacion.
# FLITMIG_TARGET_FM_AUTH_TOKEN=
#
# Instancia 3 (documentos que V1 genera en caliente y nunca guarda).
# Requiere el endpoint de snapshot desplegado en la V1 del MISMO ambiente.
# El endpoint de V1 quedo SIN autenticacion (decision del lider tecnico, 2026-07-29),
# asi que FLITMIG_V1_SNAPSHOT_AUTH_TOKEN ya no hace falta: si se omite, no se manda
# cabecera. Con esto desaparece el bloqueante del token de Cognito, que caducaba a
# las ~12 h y obligaba a refrescarlo a mano entre olas.
FLITMIG_V1_SNAPSHOT_BASE_URL=https://CAMBIA_ESTO_api-v1-pdn/
# FLITMIG_V1_SNAPSHOT_AUTH_TOKEN=
#
# ── OJO: LAS TRES VARIABLES DE ORIGEN VAN AL MISMO AMBIENTE DE V1 ──
#   FLITMIG_V1_SOURCE + FLITMIG_SOURCE_FM_BASE_URL + FLITMIG_V1_SNAPSHOT_BASE_URL
# Los ids de V1 son enteros y se repiten entre ambientes: una base copia de pdn con la
# API de snapshot de dev le pide a dev el tramite 26350 — que existe, es otro y es de
# otra empresa. Devuelve documentos ajenos SIN dar error.

# ── API HTTP de migracion ──
# Mismo motor que el comando, un tramite por peticion, para dispararlo desde Postman
# sobre un CSV de ids sin entrar por SSH. Sube con el stack (`docker compose up -d`) y
# se alcanza por el gateway, con el dominio normal del ambiente:
#   POST https://api.dev.flitsas.online/api/v1/migracion/registration/26350
#        ?instancias=todas&dryRun=true    cabecera: X-Migration-Key: <la de abajo>
#
# Con false las rutas ni se registran: responden 404, no 403. Cambiarlo NO exige
# desplegar: se edita aqui y se recrea el contenedor
# (`docker compose -f docker-compose.prod.yml up -d migracion-api`).
FLITMIG_MIGRACION_API_ENABLED=false
# Llave de la cabecera X-Migration-Key. DISTINTA por ambiente y larga (32+ caracteres):
#   openssl rand -base64 36
# Si se deja vacia el host arranca pero NINGUNA llave valida (fail-closed).
FLITMIG_MIGRACION_API_KEY=
# Migraciones simultaneas. La instancia 3 admite respuestas de hasta 256 MB, asi que
# subirlo mucho deja sin memoria al contenedor.
# FLITMIG_MIGRACION_API_MAX_CONCURRENT=2
#
# `force` NO existe por HTTP: hace UPDATE a 'borrador' para esquivar el trigger de
# inmutabilidad y luego BORRA el tramite y sus hijos en cascada. Para re-migrar, el
# comando. Reintentar por HTTP es inofensivo: lo ya migrado vuelve como "Skipped".

# ── Tags de imagen (opcional, default latest) ──
# El CD los sobreescribe: tag movil (dev/qa) en DEV/QA y sha-<commit> inmutable en PDN.
# Fijalos aqui solo para operacion/rollback MANUAL (sha-<commit> deseado).
CORE_API_TAG=latest
FRONTEND_TAG=latest
PYTHON_ML_TAG=latest

# ── Aislamiento del stack (opcional) ──
# El compose ya fija name: flitdev. Solo defínela si corres varias instancias en el
# mismo VPS y necesitas que `up --remove-orphans` no borre contenedores de otro stack.
# COMPOSE_PROJECT_NAME=flitdev

# ── Marca Blanca / dominios de red (HU #12417/#12421, Feature #12368) ──
# Clave compartida Gateway <-> core-api para GET /internal/domains/active (la lista de
# dominios activos que alimenta el CORS dinamico del Gateway). Genera UNA por ambiente
# (ej. `openssl rand -base64 36`) y NUNCA la commitees. Vacia en ambos servicios =
# fail-closed: el Gateway usa solo CORS_ORIGIN (comportamiento de hoy, sin marca blanca)
# y /internal/domains/active responde 401 siempre.
FLIT_INTERNAL_API_KEY=

# CIDR de la red interna de Docker de ESTE stack (ver bloque `networks` al final de
# docker-compose.prod.yml). Alimenta DomainSeal__InternalAllowedNetworks del gateway:
# solo una peticion que llegue desde aqui puede traer un X-Flit-Domain de confianza (lo
# usa el frontend server-side resolviendo marca por la red interna, NUNCA trafico
# publico). DEBE SER DISTINTO por ambiente si DEV/QA/PDN comparten el mismo VPS —
# Docker no permite subredes solapadas en el mismo host. El CD exporta (cd.yml, setup):
# DEV 10.114.40.0/24 · QA 10.114.50.0/24 · PDN 10.114.60.0/24. Aquí, el mismo valor.
FLIT_INTERNAL_SUBNET=10.114.40.0/24

# Lista de hosts que SON FLIT (no un dominio de red de cliente), separados por coma.
# La lee el hub (frontend-hub) en runtime; el compose ya trae un default con comodines que
# sirve en los tres ambientes, asi que solo se pone para un dominio FLIT nuevo. En Trámites no
# es runtime: NEXT_PUBLIC_FLIT_HOSTS (HU #12419) se HORNEA EN BUILD por .github/workflows/cd.yml.
# Un item con prefijo "!" es una EXCLUSION exacta (sin comodin) y gana sobre los patrones
# positivos: asi los hosts de prueba de marca blanca, que viven bajo un dominio propio, se
# tratan como dominio de red (HU #12761). Esas exclusiones estan ademas horneadas en el
# respaldo por defecto de frontend/lib/brand/hosts.ts y en Domains:Allowed del appsettings.json
# de Flit.Api, para que sigan aplicando aunque esta lista no llegue al build.
# FLIT_HOSTS=dev.flitsas.online,api.dev.flitsas.online,flitsas.online,flitsas.com,!marcablancadev.flitsas.online,!marcablancaqa.flitsas.online,!marcablancapdn.flitsas.online

# ── DR. FLIT (Épica #12718, ADR-0060) ──────────────────────────────────────────────
# Ambiente que se reporta en los casos de soporte (Custom.Environment). Fijarlo en CADA VPS:
# DEV, QA o PDN. Sin valor queda DEV (el menos sensible), nunca PDN por omisión.
# DR_FLIT_DEPLOY_ENVIRONMENT=DEV
# PAT de la cuenta de servicio "Dr. FLIT" (Work Items Read & Write SOLO en FLIT - SOPORTE).
# Sin PAT el chat funciona, pero radicar un caso responde 502 con los canales de soporte.
# DR_FLIT_ADO_PAT=
# Tope diario de mensajes al LLM por usuario y compañía; false apaga el LLM sin redeploy.
# ANTHROPIC_DRFLIT_DAILY_MESSAGE_LIMIT=30
# ANTHROPIC_DRFLIT_ENABLED=true

# ── Límites por contenedor (HU #13331, Epic #13316) ──
# Sin la variable (o en 0) el contenedor NO tiene límite: así se comporta hoy. Se fijan por ambiente después de medir
# el uso normal (docs/suite/handoff-vps-identidad.md, paso 3). Memoria con sufijo (768m, 1g); CPU en núcleos (1.5).
# Ejemplo, con valores medidos: CORE_API_MEM_LIMIT=1536m, CORE_API_CPUS=2
# CORE_API_MEM_LIMIT=
# CORE_API_CPUS=
# CORE_IDENTITY_MEM_LIMIT=
# CORE_IDENTITY_CPUS=
# CORE_ICT_MEM_LIMIT=
# CORE_ICT_CPUS=
# GATEWAY_MEM_LIMIT=
# GATEWAY_CPUS=
# PYTHON_ML_MEM_LIMIT=
# PYTHON_ML_CPUS=
# FRONTEND_MEM_LIMIT=
# FRONTEND_CPUS=
# FRONTEND_HUB_MEM_LIMIT=
# FRONTEND_HUB_CPUS=
# MIGRACION_API_MEM_LIMIT=
# MIGRACION_API_CPUS=
# Prioridad ante falta de memoria del sistema (mayor = se mata primero). Sin la variable, 0 (como hoy). Recomendado:
# core-api 500 y core-identity -500, para que si hay que matar algo no sea el login. Un valor negativo exige Docker
# con root (en Docker rootless el contenedor no arranca).
# CORE_API_OOM_SCORE_ADJ=500
# CORE_IDENTITY_OOM_SCORE_ADJ=-500
# Conexiones a Postgres: el tope de cada servicio va en su cadena (`;Maximum Pool Size=N`), dejando margen en el
# max_connections del servidor. Los servicios nuevos además tienen el tope de su usuario (deploy/postgres, HU #13330).

# ── Observabilidad (HU #13332, Epic #13316) ──
# Vacía = sin telemetría (como hasta ahora). Con el perfil `observabilidad` encendido (COMPOSE_PROFILES=...,observabilidad):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://observabilidad:4317
# Grafana (trazas en Tempo, logs en Loki) solo en 127.0.0.1 del VPS; entrar por túnel SSH:
#   ssh -L 4090:127.0.0.1:4090 <vps>  →  http://localhost:4090  (revisar y cerrar el acceso de Grafana antes de abrirlo a nadie más)
# Si DEV, QA y PDN comparten la VPS, cada stack levanta el suyo (~1 GB): definir OBSERVABILIDAD_GRAFANA_PORT distinto.
# OBSERVABILIDAD_GRAFANA_PORT=4090
# OBSERVABILIDAD_MEM_LIMIT=1g

# ── Clientes de servicio (HU #13333, Epic #13316, contrato v1.3 §3) ──
# Secreto de cada cliente svc-* para pedir tokens a Identidad por client credentials. Uno distinto por servicio y por
# ambiente, al menos 32 caracteres (openssl rand -base64 32). Vacío = el cliente no se registra. El servicio que lo usa
# recibe el mismo valor en su propia configuración cuando se despliegue.
# SVC_TRAMITES_CLIENT_SECRET=
# SVC_ICT_CLIENT_SECRET=
# SVC_CONSULTAS_CLIENT_SECRET=
# SVC_NOTIFICACIONES_CLIENT_SECRET=
# SVC_IDENTIDAD_CLIENT_SECRET=

# ── ICT: del secreto HMAC al token de Identidad (HU #13335) — orden en docs/suite/handoff-vps-suite.md §4.8 ──
# ICT_SERVICE_TOKEN_ACCEPT_IDENTITY=false
# ICT_SERVICE_TOKEN_USE_IDENTITY=false
# ICT_IDENTITY_TOKEN_ENDPOINT=http://gateway:4002/connect/token
# ICT_SERVICE_TOKEN_ACCEPT_LEGACY=true

# ── Consultas remoto (core-consultas, HU #13344) — apagado por defecto ──
# Antes de encenderlo: core-consultas desplegado y deploy/postgres/migrar-configuracion-consultas.sql corrido.
# CONSULTAS_REMOTO_HABILITADO=false
# CONSULTAS_REMOTO_ADDRESS=http://core-consultas:8084
# Si core-consultas no responde: true = consultar en proceso (respaldo); false = «consulta no disponible».
# CONSULTAS_REMOTO_RESPALDO=true
# ICT directo a core-consultas (necesita ICT_SERVICE_TOKEN_USE_IDENTITY=true). Vacía = por core-api.
# ICT_CORE_CONSULTAS_ADDRESS=http://core-consultas:8084
# core-consultas (perfil "consultas"; pasos en docs/suite/handoff-vps-suite.md §4.9). Puertos internos, sin publicar.
# CONNECTION_STRING_CONSULTAS=Host=host.docker.internal;Port=5432;Database=flit_dev;Username=flit_consultas;Password=CAMBIA_ESTA_PASSWORD;SSL Mode=Disable
# CORE_CONSULTAS_TAG=dev
# CORE_CONSULTAS_PORT=4026
# CORE_CONSULTAS_GRPC_PORT=8084
# CORE_CONSULTAS_MEM_LIMIT=
# CORE_CONSULTAS_CPUS=
