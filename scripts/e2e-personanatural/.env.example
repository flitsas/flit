# Claves SOLO de la máquina local del recorrido Persona Natural. Copia este archivo a .env.local
# y reemplaza cada valor. .env.local no se versiona. No uses estas claves en ningún ambiente compartido.
PN_E2E_SEC_TRAMITES=reemplaza-secreto-svc-tramites
PN_E2E_SEC_CONSULTAS=reemplaza-secreto-svc-consultas
PN_E2E_SEC_NOTIFICACIONES=reemplaza-secreto-svc-notificaciones
PN_E2E_SEC_PERSONANATURAL=reemplaza-secreto-svc-personanatural
PN_E2E_MQ_TRAMITES_CLAVE=reemplaza-clave-rabbit-tramites
PN_E2E_MQ_PN_CLAVE=reemplaza-clave-rabbit-personanatural
PN_E2E_MQ_CONSULTAS_CLAVE=reemplaza-clave-rabbit-consultas
PN_E2E_MQ_NOTIF_CLAVE=reemplaza-clave-rabbit-notificaciones
PN_E2E_PII_HMAC=reemplaza-clave-hmac-local-de-32-bytes-minimo
PN_E2E_KYVERUM_RUNT_API_KEY=reemplaza-llave-ficticia-kyverum
