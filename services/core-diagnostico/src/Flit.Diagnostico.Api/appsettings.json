{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Diagnostico": {
    "Plataforma": {
      "GatewayUrl": "",
      "RegistrarManifiesto": true
    },
    "Identidad": {
      "Address": "",
      "SimularSuscripcionActiva": false
    },
    "Fuentes": {
      "ImpuestoDisponible": false
    },
    "Tramites": {
      "Address": ""
    },
    "TiposTramite": {
      "Habilitados": [ "TRASPASO_STANDARD", "TRASPASO_UNILATERAL", "TRASPASO_TRANSFERENCIA_DE_DOMINIO" ]
    }
  },
  "Platform": {
    "Auth": {
      "Audience": "diagnostico"
    },
    "ServiceClient": {
      "ClientId": "svc-diagnostico"
    },
    "Messaging": {
      "Producer": "diagnostico"
    }
  }
}
