# deploy/edge/acme/flit-acme.env.example
#
# Copiar a /etc/flit-acme/env en el VPS (permisos 0600, propietario
# flit-acme:flit-acme) y usar como EnvironmentFile= en las unidades systemd
# de este directorio. NUNCA commitear el archivo real -- solo esta plantilla
# vive en el repo (AC6).

# Misma clave que Internal__ApiKey de gateway/core-api (docker-compose.prod.yml,
# .env.prod.example) -- generar UNA por ambiente y reutilizarla aqui, no crear
# una segunda clave.
FLIT_INTERNAL_API_KEY=

# core-api DIRECTO (nunca el Gateway: /api/v1/internal/* da 404 en YARP).
# Puertos por ambiente: 4003 DEV, 5003 QA, 6003 PDN (.env.prod.example).
CORE_API_INTERNAL_URL=http://127.0.0.1:4003

# Endpoint interno de #12425 (dominios verified sin certificado).
FLIT_ACME_DOMAIN_LIST_URL=http://127.0.0.1:4003/api/v1/internal/domains/pending-certificate

# Debe ser EXACTAMENTE la misma ruta que el `location /.well-known/acme-challenge/`
# de deploy/edge/nginx/flit-network-domains.conf.example (root /var/www/acme-challenge).
ACME_WEBROOT=/var/www/acme-challenge

# Webhook generico compatible Slack/Teams (payload {"text": "..."}).
OPS_ALERT_WEBHOOK_URL=

# Opcionales -- ver comentarios de cabecera de cada script para el default.
# ACME_CERT_HOME=/etc/acme (raiz de $ssl_server_name en el catch-all de nginx,
#   ver deploy/edge/acme/README.md §Limite de nginx clasico -- resuelto de
#   forma nativa; requiere nginx >= 1.15.9)
# FLIT_ACME_STATE_DIR=/var/lib/flit-acme
# FLIT_ACME_COOLDOWN_SECS=3600
# FLIT_ACME_EXPIRY_DAYS=14
# FLIT_ACME_EXCLUDE_HOSTS=
# NGINX_RELOAD_CMD=systemctl reload nginx
