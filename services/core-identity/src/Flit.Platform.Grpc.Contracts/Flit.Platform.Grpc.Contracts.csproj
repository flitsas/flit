<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Epic #13316 (ADR-0070) — tipos comunes de los contratos gRPC entre servicios (paquete flit.platform.v1):
    claves naturales (Placa, Vin, DocumentoIdentidad) y motivos de error. La fuente es contracts/proto, validada
    con buf en CI; aquí solo se genera el código C# con Grpc.Tools. Los proyectos de contratos de cada servicio
    (Flit.<Servicio>.Grpc.Contracts) referencian este en lugar de volver a generar estos tipos.

    Ojo con Docker: contracts/proto queda fuera del contexto ./services. El primer servicio que meta este proyecto
    en su imagen amplía el contexto a la raíz del repo (ver contracts/proto/README.md).
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Flit.Platform.Grpc.V1</RootNamespace>
    <ProtoRoot>..\..\..\..\contracts\proto</ProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(ProtoRoot)\flit\platform\v1\*.proto" Exclude="$(ProtoRoot)\flit\platform\v1\usuarios_producto.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="None" />
    <!-- ADR-0089 (HU #14587): usuarios por producto. Lo atiende core-api y lo llama core-diagnostico: este archivo genera
         cliente y servidor aquí, una sola copia de los tipos para los dos lados. -->
    <Protobuf Include="$(ProtoRoot)\flit\platform\v1\usuarios_producto.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <!-- Bases del cliente y del servidor generados (ClientBase, ServerCallContext): Grpc.Core.Api, que llega con el cliente. -->
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
