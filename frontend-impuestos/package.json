{
  "name": "@flit/frontend-impuestos",
  "version": "0.1.0",
  "private": true,
  "description": "Impuestos en la FLIT Suite: liquidación de impuesto vehicular por placa y masiva, producto `impuestos`.",
  "scripts": {
    "dev": "next dev --port 4034 -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm --dir ../frontend exec playwright test --config ../frontend-impuestos/e2e/playwright.config.ts --project=chromium --workers=1"
  },
  "dependencies": {
    "@flit/auth": "workspace:*",
    "@flit/brand": "workspace:*",
    "@flit/shell": "workspace:*",
    "@flit/ui": "workspace:*",
    "lucide-react": "^1.20.0",
    "next": "16.4.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
