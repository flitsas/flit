<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Contrato gRPC de core-diagnostico (flit.diagnostico.v1), generado desde contracts/proto (ADR-0070). Los tipos comunes
    (flit.platform.v1) vienen de Flit.Platform.Grpc.Contracts y no se vuelven a generar. El .proto vive en
    contracts/proto/flit/diagnostico/v1 y el CI del servicio exige que exista (docs/suite/servicio-nuevo.md).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Flit.Diagnostico.Grpc.V1</RootNamespace>
    <ProtoRoot>..\..\..\..\contracts\proto</ProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(ProtoRoot)\flit\diagnostico\v1\*.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core-identity\src\Flit.Platform.Grpc.Contracts\Flit.Platform.Grpc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
