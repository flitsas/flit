# Plantilla para credenciales del proveedor Kyverum Verify (HU #10233).
# Copia este archivo a .env.kyverum y rellena los valores reales.
# .env.kyverum está gitignored (.gitignore: .env.*); este .example sí se commitea.
#
# NOTA IMPORTANTE — cómo se cargan estas variables:
#   - DOCKER (docker-compose): se inyectan como variables de entorno del contenedor.
#   - LOCAL (pnpm dev:core-api / dotnet watch): ASP.NET Core NO lee archivos .env.
#     Para correr en local, define los valores en
#     services/core-api/src/Flit.Api/appsettings.Development.json (sección "Kyverum",
#     también gitignored) o expórtalos en tu shell antes de arrancar.

# Activa el proveedor Kyverum (default 'mock' preserva el flujo de 3 fotos).
BIOMETRICS_PROVIDER=kyverum

# URL base de la API de Kyverum.
KYVERUM_BASE_URL=https://verify.kyverum.com

# API key de Kyverum. Solo el token, sin "Bearer ".
KYVERUM_API_KEY=REEMPLAZAR_CON_API_KEY_VIGENTE

# Opcional: Bearer (default) o el scheme que use Kyverum.
# KYVERUM_AUTH_SCHEME=Bearer

# Timeout por defecto en segundos.
KYVERUM_TIMEOUT_SECONDS=30

# URL pública BASE del webhook al que Kyverum notifica el resultado (debe ser alcanzable por Kyverum,
# rechaza host local). El backend le añade el id de correlación de cada validación.
# En local usa un túnel tipo ngrok apuntando a /api/v1/webhooks/kyverum-verify.
# El secreto de firma NO se configura aquí: Kyverum lo devuelve por-validación en el create.
#
# ⚠️ DEBE SER DISTINTO POR AMBIENTE — cada validación registra ESTA URL en Kyverum, así que el callback
# vuelve al backend que la creó. Si PDN/QA/DEV comparten la misma URL, las validaciones de un ambiente
# notifican a otro y quedan colgadas en "en_proceso" (el otro ambiente no las conoce → 404). Ej.:
#   DEV → https://api.dev.flitsas.online/api/v1/webhooks/kyverum-verify
#   QA  → https://api.qa.flitsas.online/api/v1/webhooks/kyverum-verify
#   PDN → https://api.pdn.flitsas.online/api/v1/webhooks/kyverum-verify
# Como respaldo si un webhook se pierde, el backend reconcilia por consulta (GET /v1/validations/{id}):
# worker periódico + endpoint POST /instances/{id}/biometric/{validationId}/reconcile.
KYVERUM_WEBHOOK_CALLBACK_URL=https://TU-DOMINIO-PUBLICO-DE-ESTE-AMBIENTE/api/v1/webhooks/kyverum-verify

# El certificado (PDF) de la validación se descarga de la API pública
# (GET /v1/validations/{id}/certificado) con la MISMA KYVERUM_API_KEY de arriba — no requiere
# credenciales adicionales ni login admin.

# Opcional fase 2: 'inprocess' (default) | 'rabbitmq' (stub).
# MESSAGING_IDENTITY_VALIDATION=inprocess
