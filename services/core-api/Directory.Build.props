<Project>

  <!--
    Configuracion compartida por TODOS los proyectos .NET de core-api.
    ADR-0002 §2 (Decision 1, 3, 5) y §8.1 (agente core-dotnet).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!-- CA1014: CLSCompliant unnecessary in modern code.
         CA1000: Result Pattern y Either monads requieren factories estaticas en tipos genericos.
         CA1707: underscore en nombres de test (Method_Scenario_Outcome) es convencion xUnit. -->
    <NoWarn>$(NoWarn);CA1014;CA1000;CA1707</NoWarn>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- AOT por defecto. ADR-0002 §2 Decision 5. JIT como escape documentado. -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

</Project>
