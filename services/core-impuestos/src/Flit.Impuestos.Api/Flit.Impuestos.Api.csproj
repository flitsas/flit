<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    core-impuestos (producto Impuestos, HU #14694; ADR-0093), generado con la plantilla flit-servicio. Nace con el SDK de
    plataforma: tokens por JWKS, gRPC con token de servicio, outbox e inbox en su esquema propio, salud REST y grpc.health.v1.
    Independiente de Diagnóstico (EP-CF1, IndependenciaTests): solo usa contratos gRPC públicos. Guía: docs/suite/servicio-nuevo.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Flit.Impuestos.Api</RootNamespace>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core-api\src\Flit.Platform.Sdk\Flit.Platform.Sdk.csproj" />
    <ProjectReference Include="..\Flit.Impuestos.Domain\Flit.Impuestos.Domain.csproj" />
    <ProjectReference Include="..\Flit.Impuestos.Grpc.Contracts\Flit.Impuestos.Grpc.Contracts.csproj" />
    <!-- Suscripción por petición (ObtenerProductosHabilitados de Identidad). -->
    <ProjectReference Include="..\..\..\core-identity\src\Flit.Identidad.Grpc.Contracts\Flit.Identidad.Grpc.Contracts.csproj" />
    <!-- Réplica de organismos de tránsito (flit.tramites.v1.CatalogosService de core-api, M08): solo el contrato gRPC público. -->
    <ProjectReference Include="..\..\..\core-api\src\Flit.Tramites.Grpc.Contracts\Flit.Tramites.Grpc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flit.Impuestos.Tests" />
  </ItemGroup>

</Project>
