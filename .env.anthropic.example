# Plantilla para proveedores IA de plataforma (Feature #13508 / HU #13513).
# Copia este archivo a .env.anthropic y rellena los valores reales.
# .env.anthropic está gitignored (.gitignore: .env.*); este .example sí se commitea.
#
# NOTA IMPORTANTE — cómo se cargan estas variables:
#   - DOCKER (docker-compose / docker-compose.prod.yml): se inyectan como env del contenedor core-api.
#   - LOCAL (dotnet run / watch): ASP.NET Core NO lee archivos .env. Para correr en local,
#     define los valores en services/core-api/src/Flit.Api/appsettings.Development.json
#     (secciones "Ocr", "Anthropic", "OpenAI", "Kimi", "DeepSeek", también gitignored)
#     o expórtalos en tu shell antes de arrancar.
#
# Secretos: NUNCA viajan por API admin (/api/v1/admin/plataforma/ai/*). Solo hasApiKey + apiKeyMask.

# Activa el proveedor real OCR (default 'mock' devuelve fixtures y no llama a la red).
OCR_PROVIDER=anthropic

# ── Anthropic (primario típico OCR / DR. FLIT) ───────────────────────────────
# API key de Anthropic. Solo el token (empieza por sk-ant-...).
ANTHROPIC_API_KEY=REEMPLAZAR_CON_API_KEY_VIGENTE

# Opcional: modelo de visión (default claude-haiku-4-5).
# ANTHROPIC_MODEL=claude-haiku-4-5

# Opcional: URL base de la API (default https://api.anthropic.com).
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Opcional: timeout por defecto en segundos.
# ANTHROPIC_TIMEOUT_SECONDS=60

# Opcional: máximo de tokens de salida por análisis.
# ANTHROPIC_MAX_TOKENS=2000

# ── OpenAI (failover / alternate; chat + vision) ─────────────────────────────
# OPENAI_API_KEY=REEMPLAZAR_CON_API_KEY_VIGENTE
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_VISION_MODEL=gpt-4o

# ── Kimi / Moonshot (failover / alternate; chat + vision) ────────────────────
# KIMI_API_KEY=REEMPLAZAR_CON_API_KEY_VIGENTE
# KIMI_BASE_URL=https://api.moonshot.cn/v1
# KIMI_MODEL=moonshot-v1-8k
# KIMI_VISION_MODEL=moonshot-v1-8k-vision-preview

# ── DeepSeek (failover chat; sin vision en v1) ───────────────────────────────
# DEEPSEEK_API_KEY=REEMPLAZAR_CON_API_KEY_VIGENTE
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ── DR. FLIT (Épica #12718): chat sobre el manual; usa ANTHROPIC_API_KEY por defecto ──
# Opcional: apagar el LLM del chat sin redeploy (el chat cae al buscador del manual).
# ANTHROPIC_DRFLIT_ENABLED=true
# Opcional: modelo, tope de salida, timeout y tope diario de mensajes por usuario y compañía.
# ANTHROPIC_DRFLIT_MODEL=claude-haiku-4-5
# ANTHROPIC_DRFLIT_MAX_TOKENS=600
# ANTHROPIC_DRFLIT_TIMEOUT_SECONDS=20
# ANTHROPIC_DRFLIT_DAILY_MESSAGE_LIMIT=30
