{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Core": "Host=localhost;Port=5432;Database=flit_dev;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "https://api.flit.co",
    "Audience": "flit-api",
    "TokenLifetimeHours": 12
  },
  "AllowedHosts": "*",
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "DisableAuthentication": false,
    "DefaultSenderEmail": "",
    "DefaultSenderPassword": "",
    "DefaultSenderName": "FLIT Trámites"
  },
  "Procedures": {
    "Features": {
      "DocumentUpload": true
    }
  },
  "Biometrics": {
    "Provider": "mock"
  },
  "Kyverum": {
    "BaseUrl": "https://verify.kyverum.com",
    "ApiKey": "",
    "AuthScheme": "Bearer",
    "TimeoutSeconds": 30,
    "WebhookCallbackUrl": ""
  },
  "Messaging": {
    "IdentityValidation": "inprocess"
  },
  "PasswordRecovery": {
    "ResetUrlBase": "http://localhost:4001/reset-password",
    "TokenLifetimeMinutes": 30,
    "MinPasswordLength": 8
  },
  "Database": {
    "RunStartupMigrations": false
  }
}