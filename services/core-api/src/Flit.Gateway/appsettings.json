{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["https://flit.co", "https://app.flit.co", "http://localhost:4001"]
  },
  "Jwt": {
    "Issuer": "https://api.flit.co",
    "Audience": "flit-api",
    "PublicKeyPem": ""
  },
  "RateLimit": {
    "PerIpPermitsPerMinute": 600,
    "PerUserPermitsPerMinute": 1200,
    "LoginEndpointPermitsPerMinute": 10
  },
  "Internal": {
    "ApiBaseUrl": "http://core-api:4003",
    "ApiKey": ""
  },
  "DomainSeal": {
    "InternalAllowedNetworks": []
  },
  "ReverseProxy": {
    "Routes": {
      "swagger-ui-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/swagger" }
      },
      "swagger-assets-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/swagger/{**catch-all}" }
      },
      "core-api-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ],
        "AuthorizationPolicy": "JwtRequired"
      },
      "signalr-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/hubs/{**catch-all}" },
        "AuthorizationPolicy": "JwtRequired"
      },
      // FLIT Suite A-05 (HU #12990): servidor OIDC del hub en core-api. Sin JwtRequired: authorize, token, login y
      // el descubrimiento son públicos por definición. Si Suite:Oidc:Enabled está apagada, core-api responde 404.
      // HU #13225: las rutas con FlitIdentity van a core-identity cuando Gateway:IdentityCluster:Enabled está
      // encendida (IdentityClusterProxyConfigFilter); apagada, a core-api como siempre. Conservan su política.
      "oidc-connect-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/connect/{**catch-all}" },
        "Metadata": { "FlitIdentity": "true" }
      },
      "oidc-well-known-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/.well-known/{**catch-all}" },
        "Metadata": { "FlitIdentity": "true" }
      },
      "auth-public-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" },
        "Metadata": { "FlitIdentity": "true" }
      },
      // HU #13225: antes caían en core-api-route; misma política (JwtRequired) para no cambiar nada con la bandera
      // apagada. /platform/me/apps arma el inicio del hub.
      "platform-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/v1/platform/{**catch-all}" },
        "AuthorizationPolicy": "JwtRequired",
        "Metadata": { "FlitIdentity": "true" }
      },
      // HU #13225: marca de la pantalla de login. Antes caía en public-route (sin política); igual aquí.
      "public-branding-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/v1/public/branding/{**catch-all}" },
        "Metadata": { "FlitIdentity": "true" }
      },
      // HU #13087 (Épica #12737) — API de clientes de integración externos (Flito). Sin JwtRequired:
      // el pase externo NO es de la plataforma (emisor, audiencia y llave propios) y lo valida core-api
      // con el esquema ExternalClient. Si JwtRequired se reactiva, el Gateway no debe cortar este prefijo.
      "external-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/v1/external/{**catch-all}" }
      },
      // Sin esta ruta, /api/v1/public/* caia en el catch-all (core-api-route,
      // AuthorizationPolicy: JwtRequired) y el Gateway rechazaba con 401 las peticiones
      // sin JWT (p. ej. un <img src> del banner promocional, que no puede mandar
      // Authorization header) antes de llegar al backend, donde el endpoint SI es
      // AllowAnonymous(). En local no se notaba porque el proxy de next.config.ts
      // pega directo a core-api, sin pasar por el Gateway. Alcance igual al de
      // TenantEnforcementMiddleware, que ya excluye /api/v1/public/* por diseno.
      "public-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/v1/public/{**catch-all}" }
      },
      "kyverum-webhook-public-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/v1/webhooks/{**catch-all}" }
      },
      "idsecure-public-api-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/public/idsecure/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/public/idsecure/{**catch-all}" }
        ]
      },
      "ml-route": {
        "ClusterId": "python-ml-cluster",
        "Match": { "Path": "/ml/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ],
        "AuthorizationPolicy": "JwtRequired"
      },
      "ict-host-route": {
        "ClusterId": "core-ict-cluster",
        "Order": -100,
        "Match": {
          "Hosts": ["ict.flitsas.com", "ict.dev.flitsas.com", "ict.qa.flitsas.com", "ict.localhost"],
          "Path": "/{**catch-all}"
        }
      },
      "ict-admin-route": {
        "ClusterId": "core-ict-cluster",
        "Match": { "Path": "/api/v1/ict/{**catch-all}" },
        "AuthorizationPolicy": "JwtRequired"
      },
      "migracion-route": {
        "ClusterId": "migracion-cluster",
        "Match": { "Path": "/api/v1/migracion/{**catch-all}" }
      }
    },
    "Clusters": {
      "core-api-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "core-api-1": { "Address": "http://core-api:4003/" }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      // HU #13225: rutas del login con Gateway:IdentityCluster:Enabled. Primero core-identity y, de respaldo, core-api
      // (atiende las mismas rutas): FirstAlphabetical elige el primero sano según /health/ready. Si identidad se cae o
      // aún no está lista, el login sigue en core-api; si core-api se cae, sigue en identidad. En el VPS el compose
      // sobrescribe las direcciones con CORE_IDENTITY_PORT y CORE_API_PORT.
      "core-identity-cluster": {
        "LoadBalancingPolicy": "FirstAlphabetical",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:02",
            "Timeout": "00:00:02",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        },
        "Destinations": {
          "a-core-identity": { "Address": "http://core-identity:4004/" },
          "b-core-api": { "Address": "http://core-api:4003/" }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "python-ml-cluster": {
        "Destinations": {
          "python-ml-1": { "Address": "http://python-ml:4012/" }
        },
        "HttpRequest": { "ActivityTimeout": "00:01:00" }
      },
      "core-ict-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "core-ict-1": { "Address": "http://core-ict:4020/" }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      // Migrador V1 -> V2. Cluster PROPIO a proposito: una migracion de instancia 3
      // (snapshot de PDFs + subidas de 9-12 MB) tarda mucho mas de 30 s, y bajo el
      // ActivityTimeout de core-api el gateway devolveria 504 sobre migraciones que SI
      // se completaron. En YARP el timeout es por cluster, asi que subirlo aqui no toca
      // el resto del trafico. NO mover esta ruta a core-api-cluster.
      // 4030 es el puerto de DEV/local. En el VPS el compose lo sobrescribe con
      // MIGRACION_API_PORT (DEV 4030 / QA 5030 / PDN 6030), la misma variable con la
      // que arranca migracion-api: si el override falta, el gateway apunta a un puerto
      // donde nadie escucha y /admin/migracion responde 502 sin cuerpo.
      "migracion-cluster": {
        "Destinations": {
          "migracion-api-1": { "Address": "http://migracion-api:4030/" }
        },
        "HttpRequest": { "ActivityTimeout": "00:30:00" }
      }
    }
  }
}
