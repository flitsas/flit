    "/api/v1/external/tramites/{id}/adjuntos/{adjuntoId}/url": {
      "get": {
        "tags": [
          "Sincronización"
        ],
        "operationId": "urlFactura",
        "summary": "URL firmada de la factura",
        "description": "Solo facturas. Exige external.tramites.read. Pedirla justo antes de descargar; ante un fallo, pedir otra.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "id del trámite.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "adjuntoId",
            "in": "path",
            "required": true,
            "description": "factura.adjuntoId del ítem.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "URL firmada. Cache-Control: no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdjuntoUrl"
                },
                "example": {
                  "url": "https://almacen.ejemplo.test/facturas/0192b7c4?firma=ejemplo",
                  "expiraEn": "2026-09-21T10:30:00-05:00",
                  "nombreArchivo": "factura.pdf",
                  "contentType": "application/pdf"
                }
              }
            }
          },
          "401": {
            "description": "Sin pase, pase caducado o de otro emisor. Incluye WWW-Authenticate: Bearer.",
            "content": {
