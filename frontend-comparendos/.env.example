# Comparendos en tu máquina (docs/suite/local.md). Copia este archivo a .env.local (ignorado por git).
# Abre siempre http://127.0.0.1:4023, nunca localhost (las cookies de sesión no distinguen puertos).

# El gateway que atiende /api/v1/* (enruta /api/v1/comparendos/* a core-comparendos y el resto a core-api).
CORE_API_ORIGIN=http://127.0.0.1:4002
BRANDING_INTERNAL_API_URL=http://127.0.0.1:4003
# Hub (servidor OIDC y menú de productos) y Trámites (Ayuda y Cambiar contraseña de la barra).
FLIT_HUB_URL=http://127.0.0.1:4022
TRAMITES_URL=http://127.0.0.1:3000
