<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Flit.Api</RootNamespace>
    <UserSecretsId>tramites-api-dev</UserSecretsId>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flit.Admin.Application\Flit.Admin.Application.csproj" />
    <ProjectReference Include="..\Flit.Admin.Domain\Flit.Admin.Domain.csproj" />
    <ProjectReference Include="..\Flit.Analytics.Application\Flit.Analytics.Application.csproj" />
    <ProjectReference Include="..\Flit.DrFlit.Application\Flit.DrFlit.Application.csproj" />
    <ProjectReference Include="..\Flit.Infrastructure\Flit.Infrastructure.csproj" />
    <!-- Epic #13217 (HU #13232): validación de tokens, dominio sellado y hosts de productos, compartidos con core-identity. -->
    <ProjectReference Include="..\Flit.Suite.AspNetCore\Flit.Suite.AspNetCore.csproj" />
    <!-- Epic #13217 — SOLO durante la transición: core-api sigue atendiendo el login como respaldo del gateway. Se
         quita en el corte (HU #13235); desde entonces un cambio en core-identity no reconstruye core-api. -->
    <ProjectReference Include="..\..\..\core-identity\src\Flit.Identity.Application\Flit.Identity.Application.csproj" />
    <ProjectReference Include="..\..\..\core-identity\src\Flit.Identity.Web\Flit.Identity.Web.csproj" />
    <ProjectReference Include="..\Flit.Tramites.Application\Flit.Tramites.Application.csproj" />
    <ProjectReference Include="..\Flit.Modules.Security.Application\Flit.Modules.Security.Application.csproj" />
    <ProjectReference Include="..\Flit.Modules.Quipux.Application\Flit.Modules.Quipux.Application.csproj" />
    <!-- Contratos gRPC compartidos con core-ict (ICT). El .csproj vive en services/core-ict/. -->
    <ProjectReference Include="..\..\..\core-ict\src\Flit.Ict.Grpc.Contracts\Flit.Ict.Grpc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Feature #12201 — Flit.Admin.Tests invoca los delegates internos de
         AdminGeneracionDocumentalEndpoints para verificar el contrato de respuesta
         ({ id, status } en application/json, nunca application/pdf). -->
    <InternalsVisibleTo Include="Flit.Admin.Tests" />
    <!-- HU #12922 — DrFlitEndpointsTests invoca el delegate interno del chat. -->
    <InternalsVisibleTo Include="Flit.Infrastructure.Tests" />
    <!-- Bug #13194 — Bug13194UsersEmailUnicoSoloVivosTests ejecuta ResolveIctCreatorAsync contra PostgreSQL. -->
    <InternalsVisibleTo Include="Flit.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- HU #12921 (ADR-0060 §3) — manual de DR. FLIT generado por `pnpm manual:export`. Se lee del
         content root en runtime, así que va a la salida y al publish (en Docker el content root es
         la carpeta publicada). -->
    <Content Update="Content\dr-flit\manual-catalog.generated.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
