views {
  // V10. Fuente: Flit.Tramites.Application/Ocr y Flit.Infrastructure/Ai. El orden de respaldo entre proveedores: [por verificar].
  dynamic view flujo_ocr_ia {
    title 'OCR de un documento del trámite'
    description 'Del documento al modelo pasando por el router de IA. Orden de respaldo entre proveedores: [por verificar].'
    usuarios.gestor -> flit2.apps.tramites_web 'Carga el documento'
    flit2.apps.tramites_web -> flit2.gateway '/api/v1 desde el BFF'
    flit2.gateway -> flit2.negocio.core_api.dominio.ocr 'Analiza el documento'
    flit2.negocio.core_api.dominio.ocr -> flit2.negocio.core_api.ia_mod.ia_router 'Pide al modelo'
    flit2.negocio.core_api.ia_mod.ia_router -> terceros.llm 'Extrae los datos'
    flit2.negocio.core_api.dominio.ocr -> flit2.datos.db 'Guarda el resultado'
    autoLayout TopBottom 45 25
  }

  // V10, variante de Comparendos.
  dynamic view flujo_ocr_comparendos {
    title 'OCR de comparendos'
    flit2.apps.comparendos_web -> flit2.gateway '/api/v1/comparendos'
    flit2.gateway -> flit2.negocio.core_comparendos 'Reenvía'
    flit2.negocio.core_comparendos -> satelites.file_manager 'Guarda la evidencia'
    flit2.negocio.core_comparendos -> terceros.llm 'Extrae los datos'
    flit2.negocio.core_comparendos -> flit2.datos.db 'Guarda el resultado'
    autoLayout TopBottom 45 25
  }
}
