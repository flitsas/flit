// Landscape de la empresa: actores, sistemas de FLIT y sistemas externos, sin detalle interno.
// Lo interno de cada sistema vive en su repo: flit (docs/arquitectura) y flito (docs/arquitectura).
// Lo marcado [por verificar] no se pudo comprobar en el código de flit ni de flito al escribirlo (06/11/2026).
model {
  // ── Actores ──────────────────────────────────────────────
  ciudadano = actor 'Ciudadano / propietario' {
    #pii
    description 'Firma, valida identidad y consulta su trámite; radica en el portal de Persona Natural'
  }
  gestor = actor 'Gestor / radicador' {
    description 'Usuario de empresa cliente que radica y sigue trámites'
  }
  organismo = actor 'Organismo de tránsito' {
    description 'Secretaría que recibe, revisa y aprueba trámites'
  }
  cea = actor 'CEA' {
    description 'Centro de enseñanza automovilística'
  }
  admin_compania = actor 'Administrador de compañía'
  superadmin = actor 'Administrador FLIT'
  operador_flito = actor 'Operador / finanzas FLITO'
  integrador = actor 'Integrador (sistema del cliente)' {
    #externo_publico
    description 'Sistema de un cliente que consume las API de integración'
  }

  // ── Sistemas de FLIT ─────────────────────────────────────
  flit2 = system 'FLIT 2.0 (Suite)' {
    #critico #pii #suite
    description 'Hub, Trámites, Comparendos, Diagnóstico y Persona Natural. Monorepo flitsas/flit'
    link https://github.com/flitsas/flit 'Repositorio'
    metadata {
      owner 'Líder técnico FLIT 2.0 [por verificar]'
      repo 'flitsas/flit'
      criticidad 'critica'
      datos_personales 'si'
    }
  }
  flit1 = system 'FLIT 1 (legado)' {
    #legado #pii
    description 'Sistema legado en retiro hacia FLIT 2.0. Se modela como una sola caja, sin detalle [por verificar]'
    metadata {
      owner 'Mantenimiento del legado [por verificar]'
      repo 'Repositorios legados de flitsas [por verificar]'
      criticidad 'alta'
      datos_personales 'si'
    }
  }
  flito = system 'FLITO (Operaciones)' {
    #critico #pii
    description 'Operación para organismos, CEA y gestoras: SOAT, impuestos, derechos, comparendos, liquidación y facturación'
    link https://github.com/flitsas/flito 'Repositorio'
    metadata {
      owner 'Líder FLITO [por verificar]'
      repo 'flitsas/flito'
      criticidad 'critica'
      datos_personales 'si'
    }
  }
  atlas = system 'Flit Atlas' {
    #pii
    description 'Conocimiento central: catálogo, equipo, contratos, documentación, diagramas y gobierno de IA'
    link https://github.com/flitsas/flit-atlas 'Repositorio'
    metadata {
      owner 'Líder técnico [por verificar]'
      repo 'flitsas/flit-atlas'
      criticidad 'media'
      datos_personales 'si'
    }
  }
  scheduler = system 'flit-scheduler' {
    description 'Ejecuta peticiones HTTP periódicas contra las API de FLIT'
    metadata {
      owner 'DevOps [por verificar]'
      repo 'flitsas/flit-scheduler'
      criticidad 'media'
      datos_personales 'no'
    }
  }
  file_manager = system 'File manager (MinIO)' {
    #pii
    description 'Gestor de archivos de la plataforma, sobre almacenamiento S3'
    metadata {
      owner 'DevOps [por verificar]'
      repo 'flitsas/flit-file-manager-minio'
      criticidad 'alta'
      datos_personales 'si'
    }
  }
  firmas = system 'FLIT Firmas' {
    #pii
    description 'Apalanca firmas de trámites en borrador'
    metadata {
      owner 'Líder Firmas [por verificar]'
      repo 'flitsas/flit-firmas'
      criticidad 'media'
      datos_personales 'si'
    }
  }
  egress = system 'flit-egress' {
    description 'Proxy de salida controlado hacia destinos externos'
    metadata {
      owner 'DevOps [por verificar]'
      repo 'flitsas/flit-egress'
      criticidad 'alta'
      datos_personales 'no'
    }
  }
  certify = system 'FLIT Certify' {
    description 'Plataforma de QA multitenant'
    metadata {
      owner 'QA [por verificar]'
      repo 'flitsas/flit-certify'
      criticidad 'baja'
      datos_personales 'no'
    }
  }
  brain = system 'Flit Brain' {
    #pii
    description 'Orquestador de fuentes externas. Sin referencias desde flit ni flito [por verificar]'
    metadata {
      owner '[por verificar]'
      repo 'flitsas/flit-brain'
      criticidad 'media'
      datos_personales 'si'
    }
  }
  vigia = system 'Panel Vigía' {
    #ia
    description 'Observabilidad de la infraestructura con chat operativo [por verificar]'
    metadata {
      owner 'DevOps [por verificar]'
      repo 'flitsas/flit-infra-studio'
      criticidad 'media'
      datos_personales 'no'
    }
  }
  maps = system 'FLIT Maps' {
    #pii #ia
    description 'Mapas e inteligencia de comparendos. Sin repo en flitsas [por verificar]'
    metadata {
      owner '[por verificar]'
      repo '[por verificar]'
      criticidad 'baja'
      datos_personales 'si'
    }
  }
  people = system 'FLIT People' {
    #pii #objetivo
    description 'Producto del catálogo de Atlas; su repo no tiene código [por verificar]'
    metadata {
      owner '[por verificar]'
      repo 'flitsas/flit-people'
      criticidad 'baja'
      datos_personales 'si'
    }
  }
  sentinel = system 'FLIT Sentinel' {
    #objetivo
    description 'Producto del catálogo de Atlas; sin repo identificado [por verificar]'
    metadata {
      owner '[por verificar]'
      repo '[por verificar]'
      criticidad 'baja'
      datos_personales 'no'
    }
  }

  // ── Externos ─────────────────────────────────────────────
  runt = external 'RUNT'
  simit = external 'SIMIT (FCM)'
  rues = external 'RUES'
  verifik = external 'Verifik'
  kyverum = external 'Kyverum'
  intempo = external 'Intempo'
  quipux = external 'Quipux'
  idsecure = external 'IdSecure'
  fasecolda = external 'Fasecolda'
  siigo = external 'Siigo → DIAN'
  rndc = external 'RNDC'
  uiaf = external 'UIAF (SIREL)'
  supertransporte = external 'Supertransporte (PESV)'
  google_drive = external 'Google Drive'
  whatsapp = external 'WhatsApp (Meta)'
  zapsign = external 'ZapSign'
  mercadolibre = external 'MercadoLibre'
  llm = external 'Proveedores LLM' {
    #ia
    description 'Anthropic y proveedores compatibles con OpenAI'
  }
  ado = external 'Azure DevOps'
  correo = external 'Proveedor SMTP'
  objstore = external 'Almacenamiento S3'
  fuente_comparendos = external 'Fuente de comparendos' {
    description 'Proveedor que exige salir por el proxy de salida'
  }

  // ── Actores → sistemas ───────────────────────────────────
  gestor -> flit2 'Radica y sigue trámites'
  organismo -> flit2 'Revisa y aprueba trámites'
  ciudadano -> flit2 'Firma, valida identidad y radica'
  admin_compania -> flit2 'Administra usuarios y productos'
  superadmin -> flit2 'Parametriza la plataforma'
  integrador -> flit2 'API externa e ICT' {
    #externo_publico
  }
  operador_flito -> flito 'Opera SOAT, impuestos y liquidación'
  organismo -> flito 'Consulta y gestiona'
  cea -> flito 'Consulta y gestiona'

  // ── FLIT 1 / FLIT 2 ↔ FLITO ──────────────────────────────
  flito -> flit1 'Lee reporte de trámites y facturas' {
    #vigente
  }
  flit2 -[async]-> flito 'Aviso tramite.cambio (webhook firmado)'
  flito -> flit2 'Lee el feed external-api y envía adjuntos'

  // ── FLIT 2 → externos (detalle en flit/docs/arquitectura) ─
  flit2 -> verifik 'Consulta RUNT, SIMIT, RUES y RNMC'
  flit2 -> kyverum 'RUNT, comparendos y certificados'
  kyverum -[async]-> flit2 'Webhooks'
  flit2 -> intempo 'Consulta RUNT'
  flit2 -> rues 'Consulta empresa'
  flit2 -> quipux 'Bandeja de organismos'
  idsecure -> flit2 'Validación de identidad [por verificar]'
  flit2 -> llm 'OCR, Dr. FLIT y redacción' {
    #ia
  }
  flit2 -> ado 'Escala casos de soporte'
  flit2 -> correo 'Envía correo'
  flit2 -> objstore 'Guarda archivos'
  flit2 -> file_manager 'Adjuntos'
  flit2 -> egress 'Salida controlada'
  egress -> fuente_comparendos 'Consulta comparendos'

  // ── FLITO → externos (detalle en flito/docs/arquitectura) ─
  flito -> runt 'Consulta directa'
  flito -> simit 'Estado de cuenta y comparendos'
  flito -> verifik 'SIMIT'
  flito -> kyverum 'RUNT y CEA'
  flito -> fasecolda 'Guía de valores'
  flito -> siigo 'Facturación electrónica'
  flito -> rndc 'Despachos'
  flito -> uiaf 'Reportes LAFT'
  flito -> supertransporte 'PESV'
  flito -> google_drive 'Lee documentos'
  flito -> whatsapp 'Mensajería'
  flito -> zapsign 'Firma electrónica'
  flito -> mercadolibre 'Precios de referencia'
  flito -> llm 'OCR y Dr. FLIT' {
    #ia
  }
  flito -> ado 'Escala casos de soporte'

  // ── Satélites (repos distintos de flit y flito: solo se leyó su README) ─
  scheduler -> flit1 'Dispara jobs HTTP [por verificar]'
  firmas -> flit1 'Apalanca firmas de trámites [por verificar]'
  vigia -> llm 'Chat operativo [por verificar]' {
    #ia
  }
  maps -> llm 'Inteligencia [por verificar]' {
    #ia
  }

  // ── Atlas ────────────────────────────────────────────────
  flit2 -> atlas 'Publica contratos desde CI (OIDC)'
  flito -> atlas 'Publica desde CI [por verificar]' {
    #objetivo
  }
}
