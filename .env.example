# FLIT — Plantilla de .env raíz (credenciales de tooling externo)
# Copia este archivo a .env y rellena. .env está gitignored.
# Para llenarlo en modo guiado: ./scripts/setup-env.sh --interactive
# Para verificar en CI:         ./scripts/setup-env.sh --check
#
# NOTA: Los secretos de RUNTIME (passwords containers, JWT keys) viven en
# infra/secrets/.env.dev y los genera ./scripts/gen-secrets.sh.
# NO los dupliques aquí.

# ============================================================================
# Azure DevOps (Boards / Repos / Pipelines)
# ============================================================================
# PAT con scopes mínimos: Work Items (read & write), Code (read), Build (read)
# Obtener: https://dev.azure.com -> User settings -> Personal access tokens
AZURE_DEVOPS_PAT=

# Organización Azure DevOps (la parte de la URL antes de /<project>)
AZURE_ORG=<tu-org-azure-devops>

# Proyecto Azure DevOps
AZURE_PROJECT=FLIT

# (Opcional) team default para queries de iteraciones
AZURE_TEAM=

# ============================================================================
# SonarCloud
# ============================================================================
# Token: https://sonarcloud.io/account/security
SONAR_TOKEN=

# Organización (slug, ej: "miempresa")
SONAR_ORGANIZATION=

# ============================================================================
# GitHub (opcional — solo si usas gh CLI o un MCP de GitHub)
# ============================================================================
# Generalmente NO se necesita si tienes gh auth login configurado.
# GITHUB_TOKEN=

# ============================================================================
# Verifik (RUNT) — token oficial colombiano
# ============================================================================
# Vive en archivo separado .env.verifik (gitignored).
# NO duplicar aquí. Ver scripts/gen-secrets.sh.

USER_REAL_NAME="Tu Nombre Completo"
USER_REAL_EMAIL="tu.email@ejemplo.com"
AZURE_ORG_URL="https://dev.azure.com/<TU_ORG>"
AZURE_PROJECT_NAME="<TU_PROYECTO>"
AZURE_PAT="<TU_PERSONAL_ACCESS_TOKEN>"
QA_LEAD_NAME="QA Nombre Completo"
QA_LEAD_EMAIL="qa.email@ejemplo.com"