# Plantilla para credenciales del proveedor Kyverum RUNT (HU #10465, generación de improntas).
# Copia este archivo a .env.kyverum-runt y rellena los valores reales.
# .env.kyverum-runt está gitignored (.gitignore: .env.*); este .example sí se commitea.
#
# runt.kyverum.com es un dominio DISTINTO de verify.kyverum.com (Kyverum Verify, biometría,
# ver .env.kyverum.example): mismo proveedor, otro producto y otra API key/scope.
#
# NOTA IMPORTANTE — cómo se cargan estas variables:
#   - DOCKER (docker-compose): se inyectan como variables de entorno del contenedor.
#   - LOCAL (pnpm dev:core-api / dotnet watch): ASP.NET Core NO lee archivos .env.
#     Para correr en local, define los valores en
#     services/core-api/src/Flit.Api/appsettings.Development.json (sección "ImprontaRunt",
#     también gitignored) o expórtalos en tu shell antes de arrancar.

# URL base de la API de Kyverum RUNT.
KYVERUM_RUNT_BASE_URL=https://runt.kyverum.com

# API key de Kyverum RUNT con scope impronta:generar. Solo el token, sin "Bearer ".
KYVERUM_RUNT_API_KEY=REEMPLAZAR_CON_API_KEY_VIGENTE

# Opcional: Bearer (default) o el scheme que use Kyverum.
# KYVERUM_RUNT_AUTH_SCHEME=Bearer

# Timeout por defecto en segundos.
KYVERUM_RUNT_TIMEOUT_SECONDS=30
