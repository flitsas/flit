{
  "ConnectionStrings": {
    "Core": "Host=localhost;Port=5432;Database=flit_dev;Username=postgres;Password=postgres"
  },
  "Database": {
    "AutoMigrate": true
  },
  "IctJwt": {
    "Issuer": "https://ict.flit.co",
    "Audience": "flit-ict",
    "TokenLifetimeHours": 2,
    "PrivateKeyPem": "",
    "PrivateKeyPath": ""
  },
  "CoreApiGrpc": {
    "Address": "http://localhost:4021"
  },
  "Ingest": {
    "MaxItemsPerBatch": 20
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
