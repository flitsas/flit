# Canal de notificaciones "API Renting cliente" (Features #11347/#11348/#11349)
# Copia a .env.renting (gitignored) o inyéctalas en el contenedor / el ambiente.
# En local, ASP.NET Core NO lee archivos .env: usa User Secrets, appsettings.Development.json
# (gitignored) o variables de entorno del proceso.
#
# NO COMMITEAR VALORES REALES. Los secretos de este archivo van vacíos a propósito.
#
# ---------------------------------------------------------------------------------------------
# LEE ESTO ANTES DE ENCENDER EL CANAL
# ---------------------------------------------------------------------------------------------
# Renting tiene UN SOLO ambiente y es el de PRODUCCIÓN. Los tres .pfx "de pruebas" del
# repositorio del cliente son el MISMO archivo byte a byte: un marcador de posición, no un
# certificado de un ambiente de pruebas. Por eso TODOS nuestros ambientes apuntan al mismo
# endpoint, y por eso el desvío de destinatario es la única barrera que impide que una prueba
# nuestra le llegue a un cliente final real.
#
# El endpoint es el mismo en todas partes; lo que cambia por ambiente es el DESVÍO, y quien lo
# gobierna es ASPNETCORE_ENVIRONMENT de NUESTRO servicio (no la URL de Renting):
#
#   ASPNETCORE_ENVIRONMENT != Production  ->  el desvío es OBLIGATORIO   (override=true)
#   ASPNETCORE_ENVIRONMENT == Production  ->  el desvío está PROHIBIDO   (override=false)
#
# El arranque FALLA en las dos direcciones, a propósito. Es decir: NO pongas
# ASPNETCORE_ENVIRONMENT=Production en DEV o QA "para que se parezca a producción" — eso apaga
# el desvío y esos ambientes empezarían a mandar correo real a clientes de Renting desde la
# cuenta de Renting, sin que nadie se entere hasta que uno llame.
#
# El canal nace APAGADO. Con RENTING_API_ENABLED distinto de "true" no se exige ninguna de las
# variables de abajo ni el material TLS, y el servicio arranca con normalidad.
# ---------------------------------------------------------------------------------------------

# Interruptor del canal. Con cualquier valor distinto de "true", se ignora todo lo demás.
RENTING_API_ENABLED=false

# --- Conexión y credenciales (OBLIGATORIAS con el canal encendido) ---------------------------
# Sin cualquiera de estas, el arranque falla con un mensaje que nombra la variable que falta.
RENTING_API_BASE_URL=
RENTING_API_KEY_NAME=Ocp-Apim-Subscription-Key
RENTING_API_KEY_VALUE=
RENTING_API_SECONDS_TIMEOUT=30

# Certificado cliente para mTLS. Ruta a un .pfx accesible por el proceso dentro del contenedor
# (móntalo como secreto/volumen; NO lo metas en la imagen ni en el repositorio).
# El certificado se carga y se valida AL ARRANCAR, no en el primer envío: si falta, si la
# passphrase no abre o si está vencido, el servicio no levanta.
# VIGENCIA: vence en marzo de 2027. Cuando expire, el canal muere con un error de TLS opaco que
# nadie va a asociar con el correo. Deja la alerta puesta.
RENTING_API_PFX_CERTIFICATE_PATH=
RENTING_API_PASSPHRASE=

# --- Login (obtención del token) -------------------------------------------------------------
RENTING_API_LOGIN_PATH=
RENTING_API_LOGIN_SECONDS_TIMEOUT=30

# NO hay que adivinarlo: mTLS y login comparten la misma identidad, así que este valor debe
# coincidir CARÁCTER A CARÁCTER con el Subject del certificado .pfx de arriba (comparación
# ordinal). Si no coincide, el arranque falla y el mensaje lo dice. Léelo del propio certificado:
#   openssl pkcs12 -in <archivo>.pfx -nokeys -clcerts | openssl x509 -noout -subject
# y respeta el formato que reporta .NET (p. ej. "CN=algo, O=algo, C=CO").
# Al renovar el certificado, este valor casi siempre cambia: actualízalo en el mismo despliegue.
RENTING_API_LOGIN_SUBJECT=

# TRAMPA: esta variable NO se exige al arrancar (su valor por defecto es cadena vacía), pero el
# login la manda en el cuerpo como "secretName". Si la olvidas, el servicio arranca sin quejarse
# y el login falla en caliente con un error de autenticación que no dice que falte nada.
# Es un NOMBRE de secreto que Renting resuelve de su lado, no el secreto en sí.
RENTING_API_LOGIN_SECRET_NAME=

# Caché del token. Opcionales: si no las pones, el TTL por defecto es 3600 s.
RENTING_API_LOGIN_CACHE_KEY=renting-api-login-token
RENTING_API_LOGIN_CACHE_SECONDS_TTL=3600

# --- Envío de correo -------------------------------------------------------------------------
RENTING_API_SEND_EMAIL_PATH=RentingNotification/emailNotification/sendEmailFile
RENTING_API_SEND_EMAIL_SECONDS_TIMEOUT=30

# Remitente con el que sale cada correo enrutado por este canal.
RENTING_API_SEND_EMAIL_SENDER_EMAIL=usadosrc@rentingcolombia.com
RENTING_API_SEND_EMAIL_SENDER_USERNAME=Tramites Renting

# Remitente "por defecto" del bloque de configuración que comparte el proxy del cliente. Hoy no
# lo consume nadie en FLIT; se modela para no divergir del contrato del cliente.
RENTING_API_SEND_EMAIL_DEFAULT_SENDER_EMAIL=tramitesvehiculos@rentingcolombia.com
RENTING_API_SEND_EMAIL_DEFAULT_SENDER_USERNAME=Tramites Vehiculos

# --- Desvío de destinatario (la barrera) -----------------------------------------------------
# Lee la advertencia de arriba. Este interruptor es AFIRMATIVO y PROPIO: el nombre del ambiente
# NUNCA decide si se desvía, solo decide si este interruptor es obligatorio o prohibido.
# Con el desvío activo, todo correo de este canal va al buzón de abajo en vez de al destinatario
# real, y la bitácora marca la fila como desviada.
#
# ÚNICA EXCEPCIÓN (decisión del PO, 2026-08-11): los envíos del BANCO DE PRUEBAS de notificaciones
# NO se desvían — llegan al buzón de pruebas configurado en su pantalla. Ese destinatario no es
# dato de un cliente, es un correo único que un SuperAdmin configuró para esto, así que desviarlo
# no protegía a nadie y rompía el propósito del módulo. La exención es alcanzable solo desde ese
# camino, nunca desde los envíos reales de notificaciones. Efecto lateral a tener presente: si el
# buzón de pruebas se configura con la dirección de una persona real, esa persona recibirá el
# correo de prueba desde la cuenta de Renting en producción.
#
#   DEV / QA / cualquier cosa que no sea Production  ->  true
#   PDN                                              ->  false
RENTING_API_SEND_EMAIL_DEVELOPMENT_RECIPIENT_OVERRIDE_ENABLED=true

# Obligatorias SOLO cuando el desvío está activo (si no, el interruptor no tendría a dónde
# desviar y el envío fallaría en silencio en vez de proteger al cliente final).
RENTING_API_SEND_EMAIL_DEVELOPMENT_RECIPIENT_EMAIL=notificaciones.renting@gmail.com
RENTING_API_SEND_EMAIL_DEVELOPMENT_RECIPIENT_USERNAME=Equipo de desarrollo FLIT

# ---------------------------------------------------------------------------------------------
# COMILLAS: los valores con espacios van SIN comillas aquí. docker-compose y los archivos .env
# las quitan, pero una variable inyectada directamente (Kubernetes, systemd, App Service) se
# queda con ellas dentro del valor, y el nombre del remitente saldría entrecomillado en el
# correo. Si tu mecanismo de despliegue exige comillas, verifica el valor ya resuelto.
# ---------------------------------------------------------------------------------------------
