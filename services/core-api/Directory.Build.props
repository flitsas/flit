<Project>

  <!--
    Configuracion compartida por TODOS los proyectos .NET de core-api.
    ADR-0002 §2 (Decision 1, 3, 5) y §8.1 (agente core-dotnet).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <!-- CA1014: CLSCompliant unnecessary in modern code.
         CA1000: Result Pattern y Either monads requieren factories estaticas en tipos genericos.
         CA1707: underscore en nombres de test (Method_Scenario_Outcome) es convencion xUnit. -->
    <NoWarn>$(NoWarn);CA1014;CA1000;CA1707</NoWarn>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- AOT por defecto. ADR-0002 §2 Decision 5. JIT como escape documentado. -->
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <!--
    SixLabors.ImageSharp 2.1.11 (pin en Directory.Packages.props) quedó marcado el 2026-10-08
    por NU1902/NU1903. Con TreatWarningsAsErrors el restore del CD de core-api aborta.
    El único parche publicado es 4.1.2, y esa línea exige licencia de Six Labors en el build
    (sixlabors.lic / SixLaborsLicenseKey). PdfSharpCore 1.3.65 además llama a
    Image.Load(Stream, out IImageFormat), que no existe desde ImageSharp 3.
    Se acepta el riesgo residual hasta tener esa licencia y migrar el cargador de firmas del FUR.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

</Project>
