# .env de PRODUCCION (VPS) — copia a `.env` junto a docker-compose.prod.yml.
# NO commitear el .env real. Este .example solo documenta las variables.
#
# Topologia (puerto expuesto == interno). Puertos POR AMBIENTE:
#   Servicio   var               DEV    QA     PDN
#   frontend   FRONTEND_PORT     4001   5001   6001
#   gateway    GATEWAY_PORT      4002   5002   6002
#   core-api   CORE_API_PORT     4003   5003   6003
#   python-ml  PYTHON_ML_PORT    4012   5012   6012
# Postgres en el HOST. Este ejemplo usa valores de DEV; ajusta segun el ambiente del VPS.

# ── Base de datos (Postgres del HOST, formato Npgsql .NET — NO la URL postgres://) ──
# Equivale a: postgres://flit:PASSWORD@host.docker.internal:5432/flit_dev?sslmode=disable
CONNECTION_STRING_CORE=Host=host.docker.internal;Port=5432;Database=flit_dev;Username=flit;Password=CAMBIA_ESTA_PASSWORD;SSL Mode=Disable

# ── CORS / dominios ── (el front de ESTE ambiente: dev/qa/pdn.flitsas.online)
CORS_ORIGIN=https://dev.flitsas.online

# ── Puertos del ambiente ──
# El CD los inyecta automaticamente segun la rama. Fijalos aqui solo para operacion
# manual (docker compose up sin el CD). Valores DEV por defecto:
FRONTEND_PORT=4001
GATEWAY_PORT=4002
CORE_API_PORT=4003
PYTHON_ML_PORT=4012
# API de migracion (perfil `migracion`). El CD NO exporta esta variable, asi que manda
# lo que diga este archivo. DEV 4030 · QA 5030 · PDN 6030.
MIGRACION_API_PORT=4030

# ── JWT ──
# Login deshabilitado temporalmente: NO se requieren llaves ni variables JWT.
# Para reactivar login en el futuro, generar llaves RS256 (scripts/gen-secrets.sh),
# montarlas en el compose y definir JWT_ISSUER / JWT_AUDIENCE.

# ── Verifik (RUNT) ──
VERIFIK_API_TOKEN=CAMBIA_ESTE_TOKEN
VERIFIK_BASE_URL=https://api.verifik.co
VERIFIK_TIMEOUT_SECONDS=30

# ── SMTP (correo de invitaciones y recuperación de contraseña) ──
# Si se omiten, el backend usará ConsoleEmailSender y el correo NO se enviará.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_DISABLE_AUTH=false
SMTP_FROM=tramitesvehiculos@flitsas.com
SMTP_PASSWORD=CAMBIA_ESTA_PASSWORD
SMTP_FROM_NAME=FLIT Tramites

# ── File Manager (donde V2 lee los binarios de los adjuntos) ──
# Sin esta variable, core-api cae al default de appsettings.json, que apunta al
# file-manager de AWS pdn. Al pasar V2 a MinIO HAY QUE definirla.
# El migrador SUBE a esta misma URL (FLITMIG_TargetFileManager__BaseUrl la reusa):
# si la API y el migrador apuntaran a sitios distintos, los adjuntos migrados
# existirian en la tabla pero no abririan. Falla en silencio.
FILE_MANAGER_BASE_URL=https://CAMBIA_ESTO_file-manager-minio/

# ── Migrador V1 -> V2 (perfil `migracion`, no se levanta solo) ──
# Solo hace falta cuando se va a migrar. Uso:
#   mkdir -p migracion   # intercambio de ids y reportes, montado en /work
#   docker compose -f docker-compose.prod.yml --profile migracion run --rm \
#     migrador --tipo registration --ids-file /work/ids.txt --dry-run
#
# Bases de datos. V1 es SOLO LECTURA: el migrador nunca escribe en el origen.
FLITMIG_V1_SOURCE=Host=CAMBIA_ESTO;Port=5432;Database=CAMBIA_ESTO;Username=CAMBIA_ESTO;Password=CAMBIA_ESTO
# V2 destino: si se omite reutiliza CONNECTION_STRING_CORE (recomendado, es la misma base).
# FLITMIG_V2_TARGET=
#
# Etiqueta del lote: permite auditar y revertir por tanda. UNO DISTINTO POR OLA.
FLITMIG_BATCH_ID=pdn-ola-1
#
# Origen de los binarios de V1 (file-manager de AWS pdn). Lectura: no exige token.
FLITMIG_SOURCE_FM_BASE_URL=https://ny46zhyeti.execute-api.us-east-1.amazonaws.com/pdn/
# FLITMIG_SOURCE_FM_AUTH_TOKEN=
# Escritura en MinIO: rellenar SOLO si el MinIO de produccion exige autenticacion.
# FLITMIG_TARGET_FM_AUTH_TOKEN=
#
# Instancia 3 (documentos que V1 genera en caliente y nunca guarda).
# Requiere el endpoint de snapshot desplegado en la V1 del MISMO ambiente.
# El endpoint de V1 quedo SIN autenticacion (decision del lider tecnico, 2026-07-29),
# asi que FLITMIG_V1_SNAPSHOT_AUTH_TOKEN ya no hace falta: si se omite, no se manda
# cabecera. Con esto desaparece el bloqueante del token de Cognito, que caducaba a
# las ~12 h y obligaba a refrescarlo a mano entre olas.
FLITMIG_V1_SNAPSHOT_BASE_URL=https://CAMBIA_ESTO_api-v1-pdn/
# FLITMIG_V1_SNAPSHOT_AUTH_TOKEN=
#
# ── OJO: LAS TRES VARIABLES DE ORIGEN VAN AL MISMO AMBIENTE DE V1 ──
#   FLITMIG_V1_SOURCE + FLITMIG_SOURCE_FM_BASE_URL + FLITMIG_V1_SNAPSHOT_BASE_URL
# Los ids de V1 son enteros y se repiten entre ambientes: una base copia de pdn con la
# API de snapshot de dev le pide a dev el tramite 26350 — que existe, es otro y es de
# otra empresa. Devuelve documentos ajenos SIN dar error.

# ── API HTTP de migracion (perfil `migracion`) ──
# Mismo motor que el comando, un tramite por peticion, para dispararlo desde Postman
# sobre un CSV de ids sin entrar por SSH:
#   docker compose -f docker-compose.prod.yml --profile migracion up -d migracion-api
#   POST http://127.0.0.1:4030/api/v1/migracion/registration/26350?instancias=todas&dryRun=true
#        cabecera: X-Migration-Key: <la de abajo>
#   docker compose -f docker-compose.prod.yml stop migracion-api   # al terminar la ola
#
# APAGADO por defecto. Con false las rutas ni se registran: responden 404, no 403.
# Se enciende por ola y se apaga al terminar; no exige desplegar nada.
FLITMIG_MIGRACION_API_ENABLED=false
# Llave de la cabecera X-Migration-Key. DISTINTA por ambiente y larga (32+ caracteres):
#   openssl rand -base64 36
# Si se deja vacia el host arranca pero NINGUNA llave valida (fail-closed).
FLITMIG_MIGRACION_API_KEY=
# Migraciones simultaneas. La instancia 3 admite respuestas de hasta 256 MB, asi que
# subirlo mucho deja sin memoria al contenedor.
# FLITMIG_MIGRACION_API_MAX_CONCURRENT=2
#
# `force` NO existe por HTTP: hace UPDATE a 'borrador' para esquivar el trigger de
# inmutabilidad y luego BORRA el tramite y sus hijos en cascada. Para re-migrar, el
# comando. Reintentar por HTTP es inofensivo: lo ya migrado vuelve como "Skipped".

# ── Tags de imagen (opcional, default latest) ──
# El CD los sobreescribe: tag movil (dev/qa) en DEV/QA y sha-<commit> inmutable en PDN.
# Fijalos aqui solo para operacion/rollback MANUAL (sha-<commit> deseado).
CORE_API_TAG=latest
FRONTEND_TAG=latest
PYTHON_ML_TAG=latest

# ── Aislamiento del stack (opcional) ──
# El compose ya fija name: flitdev. Solo defínela si corres varias instancias en el
# mismo VPS y necesitas que `up --remove-orphans` no borre contenedores de otro stack.
# COMPOSE_PROJECT_NAME=flitdev
