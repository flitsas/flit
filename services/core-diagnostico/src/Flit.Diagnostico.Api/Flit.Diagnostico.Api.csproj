<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    core-diagnostico (Diagnóstico Vehicular, HU #13721), generado con la plantilla flit-servicio (Epic #13316). Nace con el
    SDK de plataforma: tokens por JWKS, gRPC con token de servicio, outbox e inbox en su esquema propio, salud REST y
    grpc.health.v1. Guía: docs/suite/servicio-nuevo.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Flit.Diagnostico.Api</RootNamespace>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core-api\src\Flit.Platform.Sdk\Flit.Platform.Sdk.csproj" />
    <ProjectReference Include="..\Flit.Diagnostico.Domain\Flit.Diagnostico.Domain.csproj" />
    <ProjectReference Include="..\Flit.Diagnostico.Grpc.Contracts\Flit.Diagnostico.Grpc.Contracts.csproj" />
    <!-- HU #13726: suscripción por petición (ObtenerProductosHabilitados de Identidad). -->
    <ProjectReference Include="..\..\..\core-identity\src\Flit.Identidad.Grpc.Contracts\Flit.Identidad.Grpc.Contracts.csproj" />
    <!-- HU #13742: catálogo de tipos de trámite (ListarTiposTramite de flit.tramites.v1.CatalogosService, en core-api). -->
    <ProjectReference Include="..\..\..\core-api\src\Flit.Tramites.Grpc.Contracts\Flit.Tramites.Grpc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <!-- HU #13749: plantilla y lectura del .xlsx de carga (la misma librería y el mismo pin de System.IO.Packaging de core-api y Comparendos). -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="System.IO.Packaging" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- HU #13725: respuestas inventadas de Intempo para la fuente RUNT simulada (sin PII; rango ficticio en FixturesSinPiiTests). -->
  <ItemGroup>
    <EmbeddedResource Include="Modulos\Consultas\Fuentes\Fixtures\intempo-*.json" LogicalName="$(RootNamespace).Fixtures.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flit.Diagnostico.Tests" />
  </ItemGroup>

</Project>
