// Componentes de core-api (nivel 3). Cada uno apunta a sus proyectos en services/core-api/src.
model {
  extend flit2.negocio.core_api {
    entrada = grupo 'Entrada' {
      description 'Host de la API, API externa, fachada gRPC y avisos'
      api_host = component 'Host de la API' {
        technology 'Minimal API'
        description 'Endpoints y composición del servicio'
        metadata {
          aplicativo 'flit2-core-api'
          repo_path 'services/core-api/src/Flit.Api'
        }
      }
      external_api = component 'API externa' {
        #externo_publico
        description 'Feed de sincronización, autenticación de clientes y adjuntos'
        metadata {
          aplicativo 'flit2-integraciones'
          repo_path 'services/core-api/src/Flit.Api/Endpoints'
          openapi 'contracts/openapi/external-api.v1.json'
          adr 'ADR-0067, ADR-0068, ADR-0071'
        }
      }
      persona_natural = component 'Persona Natural' {
        description 'Consume radicaciones y expone la fachada gRPC'
        metadata {
          aplicativo 'flit2-core-api'
          repo_path 'services/core-api/src/Flit.Api/PersonaNatural'
          adr 'ADR-0075'
        }
      }
      avisos_flito = component 'Avisos a FLITO' {
        description 'Encola el webhook tramite.cambio'
        metadata {
          aplicativo 'flit2-core-api'
          repo_path 'services/core-api/src/Flit.Infrastructure/FlitoSignals'
          adr 'ADR-0071'
        }
      }
    }
    dominio = grupo 'Dominio' {
      description 'Trámites, OCR, Quipux, reportes y administración'
      tramites = component 'Trámites' {
        #pii
        description 'Ciclo de vida del trámite'
        metadata {
          aplicativo 'flit2-tramites'
          repo_path 'services/core-api/src/Flit.Tramites.Application'
        }
      }
      ocr = component 'OCR' {
        #ia
        description 'Análisis de documentos del trámite'
        metadata {
          aplicativo 'flit2-tramites'
          repo_path 'services/core-api/src/Flit.Tramites.Application/Ocr'
        }
      }
      improntas = component 'Improntas' {
        description 'Dominio de improntas'
        metadata {
          aplicativo 'flit2-tramites'
          repo_path 'services/core-api/src/Flit.Modules.Improntas.Domain'
        }
      }
      quipux_mod = component 'Quipux' {
        description 'Bandeja de organismos de tránsito'
        metadata {
          aplicativo 'flit2-core-api'
          repo_path 'services/core-api/src/Flit.Modules.Quipux.Application'
        }
      }
      analytics = component 'Analítica' {
        description 'Reportes 2.0'
        metadata {
          aplicativo 'flit2-reportes'
          repo_path 'services/core-api/src/Flit.Analytics.Application'
        }
      }
      admin = component 'Administración' {
        description 'Parametrización, empresas e IA'
        metadata {
          aplicativo 'flit2-administradores'
          repo_path 'services/core-api/src/Flit.Admin.Application'
        }
      }
    }
    transversal = grupo 'Transversales' {
      description 'Seguridad, identidad, plataforma y clientes de servicios'
      security = component 'Seguridad' {
        description 'Roles y permisos'
        metadata {
          aplicativo 'flit2-core-api'
          repo_path 'services/core-api/src/Flit.Modules.Security.Application'
        }
      }
      identidad = component 'Identidad' {
        #suite
        description 'Login y OIDC mientras la bandera de identidad esté apagada'
        metadata {
          aplicativo 'flit2-identidad'
          repo_path 'services/core-api/src/Flit.Identity.Infrastructure'
        }
      }
      platform = component 'Plataforma' {
        #suite
        description 'Productos, manifiesto y emisores'
        metadata {
          aplicativo 'flit2-plataforma'
          repo_path 'services/core-api/src/Flit.Modules.Platform'
        }
      }
      sdk = component 'SDK de plataforma' {
        description 'Bus, outbox y gRPC para los servicios de la suite'
        metadata {
          aplicativo 'flit2-plataforma'
          repo_path 'services/core-api/src/Flit.Platform.Sdk'
        }
      }
      consultas_mod = component 'Consultas' {
        description 'Cliente de las fuentes externas y de core-consultas'
        metadata {
          aplicativo 'flit2-consultas'
          repo_path 'services/core-api/src/Flit.Modules.Consultas'
        }
      }
      notificaciones_mod = component 'Notificaciones' {
        description 'Publicación hacia core-notificaciones'
        metadata {
          aplicativo 'flit2-notificaciones'
          repo_path 'services/core-api/src/Flit.Modules.Notificaciones'
        }
      }
    }
    ia_mod = grupo 'IA' {
      description 'Dr. FLIT y router de IA'
      drflit = component 'Dr. FLIT' {
        #ia
        description 'Asistente y escalamiento de soporte'
        metadata {
          aplicativo 'flit2-doctor-flit'
          repo_path 'services/core-api/src/Flit.DrFlit.Application'
          adr 'ADR-0060'
        }
      }
      ia_router = component 'Router de IA' {
        #ia
        description 'Multiproveedor por herramienta'
        metadata {
          aplicativo 'flit2-core-api'
          repo_path 'services/core-api/src/Flit.Infrastructure/Ai'
          adr 'ADR-0070'
        }
      }
    }
  }

  flit2.negocio.core_api.entrada.api_host -> flit2.negocio.core_api.dominio.tramites 'Casos de uso de trámites'
  flit2.negocio.core_api.entrada.api_host -> flit2.negocio.core_api.dominio.admin 'Administración'
  flit2.negocio.core_api.entrada.api_host -> flit2.negocio.core_api.transversal.security 'Autoriza'
  flit2.negocio.core_api.entrada.api_host -> flit2.negocio.core_api.transversal.identidad 'Login y OIDC'
  flit2.negocio.core_api.entrada.api_host -> flit2.negocio.core_api.transversal.platform 'Productos'
  flit2.negocio.core_api.entrada.api_host -> flit2.negocio.core_api.dominio.analytics 'Reportes'
  flit2.negocio.core_api.entrada.api_host -> flit2.negocio.core_api.ia_mod.drflit 'Asistente'
  flit2.negocio.core_api.entrada.api_host -> flit2.negocio.core_api.entrada.external_api 'Expone /api/v1/external'
  flit2.negocio.core_api.entrada.api_host -> flit2.negocio.core_api.entrada.persona_natural 'Fachada gRPC'
  flit2.negocio.core_api.dominio.tramites -> flit2.negocio.core_api.dominio.ocr 'Analiza documentos'
  flit2.negocio.core_api.dominio.tramites -> flit2.negocio.core_api.transversal.consultas_mod 'Consulta fuentes'
  flit2.negocio.core_api.dominio.tramites -> flit2.negocio.core_api.transversal.notificaciones_mod 'Notifica'
  flit2.negocio.core_api.dominio.tramites -> flit2.negocio.core_api.dominio.quipux_mod 'Bandeja de organismos'
  flit2.negocio.core_api.dominio.tramites -> flit2.negocio.core_api.dominio.improntas 'Improntas'
  flit2.negocio.core_api.dominio.tramites -> flit2.negocio.core_api.entrada.avisos_flito 'Marca cambios para FLITO'
  flit2.negocio.core_api.entrada.external_api -> flit2.negocio.core_api.dominio.tramites 'Lee el feed y recibe adjuntos'
  flit2.negocio.core_api.entrada.persona_natural -> flit2.negocio.core_api.dominio.tramites 'Crea el trámite radicado'
  flit2.negocio.core_api.dominio.ocr -> flit2.negocio.core_api.ia_mod.ia_router 'Pide al modelo'
  flit2.negocio.core_api.ia_mod.drflit -> flit2.negocio.core_api.ia_mod.ia_router 'Pide al modelo [por verificar]'
  flit2.negocio.core_api.ia_mod.ia_router -> terceros.llm 'Anthropic y compatibles con OpenAI' {
    #ia
  }
  flit2.negocio.core_api.ia_mod.drflit -> terceros.ado 'Casos de soporte'
  flit2.negocio.core_api.dominio.quipux_mod -> entidades.quipux 'Bandeja de organismos'
  flit2.negocio.core_api.transversal.consultas_mod -[grpc]-> flit2.plataforma.core_consultas 'ConsultasService'
  flit2.negocio.core_api.transversal.notificaciones_mod -[grpc]-> flit2.plataforma.core_notificaciones 'NotificacionesService'
  flit2.negocio.core_api.entrada.avisos_flito -[async]-> flit2.datos.bus 'notificaciones.webhook.send'
  flit2.negocio.core_api.dominio.tramites -[async]-> flit2.datos.bus 'tramites.*'
  flit2.negocio.core_api.dominio.tramites -> flit2.datos.db 'EF Core'
}

views {
  // V06, resumen
  view flit2_core_api_componentes of flit2.negocio.core_api {
    title 'core-api: componentes'
    description 'Resumen por grupos. Toca un grupo para ver sus componentes.'
    include
      flit2.negocio.core_api.entrada with { navigateTo flit2_core_api_entrada },
      flit2.negocio.core_api.dominio with { navigateTo flit2_core_api_dominio },
      flit2.negocio.core_api.transversal with { navigateTo flit2_core_api_transversal },
      flit2.negocio.core_api.ia_mod with { navigateTo flit2_core_api_ia },
      flit2.gateway,
      flit2.plataforma,
      flit2.datos,
      entidades,
      terceros
    autoLayout TopBottom 45 25
  }

  view flit2_core_api_entrada of flit2.negocio.core_api.entrada {
    title 'core-api: entrada'
    include
      flit2.negocio.core_api.entrada.*,
      flit2.negocio.core_api.dominio,
      flit2.negocio.core_api.transversal,
      flit2.negocio.core_api.ia_mod,
      flit2.datos
    autoLayout TopBottom 45 25
  }

  view flit2_core_api_dominio of flit2.negocio.core_api.dominio {
    title 'core-api: dominio'
    include
      flit2.negocio.core_api.dominio.*,
      flit2.negocio.core_api.entrada,
      flit2.negocio.core_api.transversal,
      flit2.negocio.core_api.ia_mod,
      flit2.datos,
      entidades
    autoLayout LeftRight 60 25
  }

  view flit2_core_api_transversal of flit2.negocio.core_api.transversal {
    title 'core-api: transversales'
    include
      flit2.negocio.core_api.transversal.*,
      flit2.negocio.core_api.entrada,
      flit2.negocio.core_api.dominio,
      flit2.plataforma
    autoLayout TopBottom 45 25
  }

  view flit2_core_api_ia of flit2.negocio.core_api.ia_mod {
    title 'core-api: IA'
    include
      flit2.negocio.core_api.ia_mod.*,
      flit2.negocio.core_api.entrada,
      flit2.negocio.core_api.dominio,
      terceros
    autoLayout TopBottom 45 25
  }
}
