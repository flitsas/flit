<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Flit.Ict.Infrastructure</RootNamespace>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Sql\Ddl\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flit.Ict.Application.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flit.Ict.Domain\Flit.Ict.Domain.csproj" />
    <ProjectReference Include="..\Flit.Ict.Application\Flit.Ict.Application.csproj" />
    <ProjectReference Include="..\Flit.Ict.Grpc.Contracts\Flit.Ict.Grpc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <!-- Epic #13316 (HU #13346): cliente de core-consultas (flit.consultas.v1) generado desde contracts/proto. Va aquí y no
         en Flit.Ict.Grpc.Contracts, que core-api referencia y donde chocaría con los tipos que core-api ya genera. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Microsoft.Extensions.{Http,Options.ConfigurationExtensions,Hosting.Abstractions} los
         provee el shared framework Microsoft.AspNetCore.App (FrameworkReference arriba). -->
  </ItemGroup>

  <PropertyGroup>
    <ContractsProtoRoot>..\..\..\..\contracts\proto</ContractsProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(ContractsProtoRoot)\flit\platform\v1\tipos.proto" ProtoRoot="$(ContractsProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(ContractsProtoRoot)\flit\consultas\v1\certificaciones.proto" ProtoRoot="$(ContractsProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(ContractsProtoRoot)\flit\consultas\v1\resultado.proto" ProtoRoot="$(ContractsProtoRoot)" GrpcServices="None" />
    <Protobuf Include="$(ContractsProtoRoot)\flit\consultas\v1\consultas.proto" ProtoRoot="$(ContractsProtoRoot)" GrpcServices="Client" />
  </ItemGroup>

</Project>
