<Project Sdk="Microsoft.NET.Sdk">

  <!-- Epic #13316 (HU #13336) — pruebas del SDK de plataforma, sin base de datos. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Flit.Platform.Sdk.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\prueba.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flit.Platform.Sdk\Flit.Platform.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- HU #13338: la outbox se prueba contra Postgres y RabbitMQ reales (ver Messaging/MessagingFixture.cs). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

</Project>
