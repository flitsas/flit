// Contenedores de FLIT 2.0 (nivel 2 de C4). Extiende el sistema flit2 del landscape (arquitectura/landscape).
// Comprobado contra el código el 06/11/2026: appsettings.json del gateway, AddFlitGrpcClient de cada servicio,
// contracts/ y docker-compose.prod.yml. k8s_workload es la llave del drift (plan 01 §8.4).
model {
  extend flit2 {
    apps = grupo 'Aplicaciones web' {
      description 'Hub y frontends de cada producto'
      hub = webapp 'Hub de la suite' {
        technology 'Next.js'
        description 'Portada, pantalla de login e inicio con los productos'
        metadata {
          aplicativo 'flit2-frontend-hub'
          owner 'Líder FLIT 2.0, frente Plataforma [por verificar]'
          repo_path 'frontend-hub'
          k8s_workload 'frontend-hub'
          criticidad 'alta'
          datos_personales 'no'
        }
      }
      tramites_web = webapp 'Trámites (web + BFF)' {
        #pii #critico
        technology 'Next.js, @flit/auth'
        description 'Producto Trámites; BFF de /api/v1; manual y Dr. FLIT'
        metadata {
          aplicativo 'flit2-frontend'
          owner 'Líder FLIT 2.0, Trámites [por verificar]'
          repo_path 'frontend'
          k8s_workload 'frontend'
          criticidad 'critica'
          datos_personales 'si'
        }
      }
      comparendos_web = webapp 'Comparendos (web)' {
        #pii
        technology 'Next.js'
        description 'Producto Comparendos'
        metadata {
          aplicativo 'flit2-frontend-comparendos'
          owner 'Líder Comparendos [por verificar]'
          repo_path 'frontend-comparendos'
          k8s_workload 'frontend-comparendos'
          criticidad 'media'
          datos_personales 'si'
        }
      }
      diagnostico_web = webapp 'Diagnóstico (web)' {
        #pii
        technology 'Next.js'
        description 'Producto Diagnóstico Vehicular'
        metadata {
          aplicativo 'flit2-frontend-diagnostico'
          owner 'Líder Diagnóstico [por verificar]'
          repo_path 'frontend-diagnostico'
          k8s_workload 'frontend-diagnostico'
          ambientes 'dev'
          criticidad 'media'
          datos_personales 'si'
        }
      }
      personanatural_web = webapp 'Portal Persona Natural (web)' {
        #pii #externo_publico
        technology 'Next.js'
        description 'Portal público: el ciudadano consulta, cotiza y radica sin cuenta'
        metadata {
          owner 'Líder Persona Natural [por verificar]'
          repo_path 'frontend-personanatural'
          k8s_workload 'frontend-personanatural'
          ambientes 'dev'
          criticidad 'media'
          datos_personales 'si'
        }
      }
    }
    gateway = service 'Gateway' {
      #critico
      technology '.NET, YARP'
      description 'Única entrada de la API: reparte cada ruta a su servicio'
      metadata {
        owner 'Líder FLIT 2.0, frente Plataforma [por verificar]'
        repo_path 'services/core-api/src/Flit.Gateway'
        k8s_workload 'gateway'
        criticidad 'critica'
        datos_personales 'no'
      }
    }
    negocio = grupo 'Servicios de negocio' {
      description 'Trámites, ICT, Comparendos, Diagnóstico, Persona Natural y migración'
      core_api = service 'core-api' {
        #pii #critico #ia
        technology '.NET 10, EF Core'
        description 'Negocio de Trámites y API externa. Atiende también el login mientras la bandera de identidad esté apagada'
        metadata {
          aplicativo 'flit2-core-api'
          owner 'Líder FLIT 2.0, Trámites [por verificar]'
          repo_path 'services/core-api/src/Flit.Api'
          k8s_workload 'core-api'
          criticidad 'critica'
          datos_personales 'si'
          openapi 'contracts/openapi/core-api.v1.yaml'
          openapi_externo 'contracts/openapi/external-api.v1.json'
          openapi_plataforma 'contracts/openapi/platform.v1.yaml'
          asyncapi 'contracts/asyncapi/tramites-events.v1.yaml'
          asyncapi_webhooks 'contracts/asyncapi/domain-events.v1.yaml'
          proto 'contracts/proto/flit/tramites/v1'
          adr 'ADR-0060, ADR-0067, ADR-0068, ADR-0071, ADR-0075'
        }
      }
      core_ict = service 'core-ict' {
        #pii #externo_publico
        technology '.NET'
        description 'Carga de trámites en lote por terceros'
        metadata {
          aplicativo 'flit2-core-ict'
          owner 'Líder Integraciones [por verificar]'
          repo_path 'services/core-ict'
          k8s_workload 'core-ict'
          criticidad 'alta'
          datos_personales 'si'
          openapi 'contracts/openapi/core-ict.v1.yaml'
        }
      }
      migracion_api = service 'migracion-api' {
        #temporal #pii
        technology '.NET'
        description 'Migración de FLIT 1 a FLIT 2'
        metadata {
          aplicativo 'flit2-migracion'
          owner 'Líder Migración [por verificar]'
          repo_path 'services/core-api/tools/Flit.DataMigration.Api'
          k8s_workload 'migracion-api'
          criticidad 'media'
          datos_personales 'si'
        }
      }
      core_comparendos = service 'core-comparendos' {
        #pii #ia
        technology '.NET'
        description 'Gestión de Comparendos (GDC V2) con OCR por LLM'
        metadata {
          aplicativo 'flit2-core-comparendos'
          owner 'Líder Comparendos [por verificar]'
          repo_path 'services/core-comparendos'
          k8s_workload 'core-comparendos'
          criticidad 'media'
          datos_personales 'si'
          proto 'contracts/proto/flit/comparendos/v1/comparendos.proto'
        }
      }
      core_diagnostico = service 'core-diagnostico' {
        #pii #ia
        technology '.NET'
        description 'Diagnóstico Vehicular: lotes, dictamen y tablero'
        metadata {
          aplicativo 'flit2-core-diagnostico'
          owner 'Líder Diagnóstico [por verificar]'
          repo_path 'services/core-diagnostico'
          k8s_workload 'core-diagnostico'
          ambientes 'dev'
          criticidad 'media'
          datos_personales 'si'
          openapi 'contracts/openapi/diagnostico.v1.yaml'
          asyncapi 'contracts/asyncapi/diagnostico-events.v1.yaml'
          proto 'contracts/proto/flit/diagnostico/v1/diagnostico.proto'
          adr 'ADR-0072, ADR-0074, ADR-0075'
        }
      }
      core_personanatural = service 'core-personanatural' {
        #pii
        technology '.NET'
        description 'BFF del portal Persona Natural; radica en core-api por bus y gRPC'
        metadata {
          owner 'Líder Persona Natural [por verificar]'
          repo_path 'services/core-personanatural'
          k8s_workload 'core-personanatural'
          ambientes 'dev'
          criticidad 'media'
          datos_personales 'si'
          proto 'contracts/proto/flit/personanatural/v1/personanatural.proto'
          adr 'ADR-0075'
        }
      }
    }
    plataforma = grupo 'Servicios de plataforma' {
      description 'Identidad, consultas, notificaciones y ML'
      core_identity = service 'core-identity' {
        #pii #critico #suite
        technology '.NET, OpenIddict'
        description 'Identidad de la suite: OIDC, autenticación, productos y empresas'
        metadata {
          aplicativo 'flit2-core-identity'
          owner 'Frente de identidad [por verificar]'
          repo_path 'services/core-identity'
          k8s_workload 'core-identity'
          criticidad 'critica'
          datos_personales 'si'
          proto 'contracts/proto/flit/identidad/v1/identidad.proto'
          asyncapi 'contracts/asyncapi/plataforma-events.v1.yaml'
        }
      }
      core_consultas = service 'core-consultas' {
        #pii
        technology '.NET, gRPC'
        description 'Consultas a fuentes externas como capacidad de plataforma'
        metadata {
          aplicativo 'flit2-core-consultas'
          owner 'Frente de consultas y notificaciones [por verificar]'
          repo_path 'services/core-consultas'
          k8s_workload 'core-consultas'
          criticidad 'alta'
          datos_personales 'si'
          proto 'contracts/proto/flit/consultas/v1'
          asyncapi 'contracts/asyncapi/consultas-events.v1.yaml'
          adr 'ADR-0065'
        }
      }
      core_notificaciones = service 'core-notificaciones' {
        #pii
        technology '.NET, gRPC'
        description 'Correo, webhooks salientes y mensajes muertos'
        metadata {
          aplicativo 'flit2-core-notificaciones'
          owner 'Frente de consultas y notificaciones [por verificar]'
          repo_path 'services/core-notificaciones'
          k8s_workload 'core-notificaciones'
          criticidad 'alta'
          datos_personales 'si'
          proto 'contracts/proto/flit/notificaciones/v1'
          asyncapi 'contracts/asyncapi/notificaciones-events.v1.yaml'
        }
      }
      python_ml = service 'python-ml' {
        #pii
        technology 'Python 3.13, FastAPI'
        description 'OCR y ML; hoy expone el OCR de cédula [por verificar quién lo consume]'
        metadata {
          aplicativo 'flit2-python-ml'
          owner 'Líder IA [por verificar]'
          repo_path 'services/python-ml'
          k8s_workload 'python-ml'
          criticidad 'baja'
          datos_personales 'si'
          openapi 'contracts/openapi/python-ml.v1.yaml'
        }
      }
    }
    datos = grupo 'Datos y mensajería' {
      description 'PostgreSQL y RabbitMQ'
      db = database 'PostgreSQL' {
        #pii #critico
        technology 'PostgreSQL'
        description 'Una base por ambiente y un esquema por servicio'
        metadata {
          owner 'DevOps [por verificar]'
          repo_path 'deploy/postgres'
          criticidad 'critica'
          datos_personales 'si'
        }
      }
      bus = queue 'RabbitMQ' {
        #pii
        technology 'RabbitMQ'
        description 'Un exchange flit.* por cada productor de eventos'
        metadata {
          owner 'DevOps [por verificar]'
          repo_path 'deploy/rabbitmq'
          k8s_workload 'rabbitmq'
          criticidad 'alta'
          datos_personales 'si'
        }
      }
    }
  }

  // ── Usuarios → aplicaciones ──────────────────────────────
  usuarios.gestor -> flit2.apps.tramites_web 'Radica y sigue trámites'
  usuarios.organismo -> flit2.apps.tramites_web 'Revisa y aprueba trámites'
  usuarios.ciudadano -> flit2.apps.tramites_web 'Firma y valida identidad'
  usuarios.ciudadano -> flit2.apps.personanatural_web 'Consulta, cotiza y radica'
  usuarios.admin_compania -> flit2.apps.hub 'Administra usuarios y productos'
  usuarios.superadmin -> flit2.apps.hub 'Parametriza la plataforma'
  integrador -> flit2.gateway 'API externa (/api/v1/external)' {
    #externo_publico
  }
  integrador -> flit2.negocio.core_ict 'Carga trámites en lote' {
    #externo_publico
  }

  // ── Aplicaciones → gateway ───────────────────────────────
  flit2.apps.tramites_web -> flit2.apps.hub 'Redirige al login OIDC'
  flit2.apps.comparendos_web -> flit2.apps.hub 'Redirige al login OIDC'
  flit2.apps.diagnostico_web -> flit2.apps.hub 'Redirige al login OIDC'
  flit2.apps.hub -> flit2.gateway '/connect y /.well-known'
  flit2.apps.tramites_web -> flit2.gateway '/api/v1 desde el BFF'
  flit2.apps.comparendos_web -> flit2.gateway '/api/v1/comparendos'
  flit2.apps.diagnostico_web -> flit2.gateway '/api/v1/diagnostico'
  flit2.apps.personanatural_web -> flit2.gateway '/api/v1/persona-natural'

  // ── Gateway → servicios (appsettings.json#ReverseProxy) ──
  flit2.gateway -> flit2.negocio.core_api '/api, /hubs, /connect y /.well-known'
  flit2.gateway -> flit2.plataforma.core_identity 'Rutas de identidad, con bandera'
  flit2.gateway -> flit2.negocio.core_comparendos '/api/v1/comparendos'
  flit2.gateway -> flit2.negocio.core_diagnostico '/api/v1/diagnostico'
  flit2.gateway -> flit2.negocio.core_personanatural '/api/v1/persona-natural'
  flit2.gateway -> flit2.plataforma.core_consultas '/api/v1/consultas/avisos'
  flit2.gateway -> flit2.negocio.core_ict '/api/v1/ict y el host de ICT'
  flit2.gateway -> flit2.negocio.migracion_api '/api/v1/migracion'
  flit2.gateway -> flit2.plataforma.python_ml '/ml'

  // ── gRPC entre servicios (AddFlitGrpcClient) ─────────────
  flit2.negocio.core_api -[grpc]-> flit2.plataforma.core_consultas 'Consultas y validación de identidad'
  flit2.negocio.core_api -[grpc]-> flit2.plataforma.core_notificaciones 'Notificaciones y mensajes muertos'
  flit2.negocio.core_api -[grpc]-> flit2.negocio.core_personanatural 'Lee la radicación'
  flit2.negocio.core_api -[grpc]-> flit2.negocio.core_ict 'Estado de vuelta a ICT'
  flit2.negocio.core_ict -[grpc]-> flit2.negocio.core_api 'Orquestación de ICT'
  flit2.negocio.core_ict -[grpc]-> flit2.plataforma.core_consultas 'ConsultasService'
  flit2.negocio.core_comparendos -[grpc]-> flit2.plataforma.core_consultas 'FuentesComparendosService'
  flit2.negocio.core_comparendos -[grpc]-> flit2.plataforma.core_identity 'IdentidadService y EmpresasService'
  flit2.negocio.core_comparendos -[grpc]-> flit2.plataforma.core_notificaciones 'NotificacionesService'
  flit2.negocio.core_comparendos -[grpc]-> flit2.negocio.core_api 'CatalogosService'
  flit2.negocio.core_diagnostico -[grpc]-> flit2.plataforma.core_consultas 'ConsultasService'
  flit2.negocio.core_diagnostico -[grpc]-> flit2.plataforma.core_identity 'IdentidadService y EmpresasService'
  flit2.negocio.core_diagnostico -[grpc]-> flit2.negocio.core_api 'CatalogosService'
  flit2.negocio.core_personanatural -[grpc]-> flit2.plataforma.core_consultas 'ConsultasService'
  flit2.negocio.core_personanatural -[grpc]-> flit2.plataforma.core_notificaciones 'NotificacionesService'
  flit2.negocio.core_personanatural -[grpc]-> flit2.negocio.core_api 'PersonaNaturalService'

  // ── Base de datos (un esquema por servicio) ──────────────
  flit2.negocio.core_api -> flit2.datos.db 'EF Core'
  flit2.plataforma.core_identity -> flit2.datos.db 'Esquemas de identidad y plataforma'
  flit2.plataforma.core_consultas -> flit2.datos.db 'Su esquema'
  flit2.plataforma.core_notificaciones -> flit2.datos.db 'Su esquema'
  flit2.negocio.core_comparendos -> flit2.datos.db 'Su esquema'
  flit2.negocio.core_diagnostico -> flit2.datos.db 'Su esquema'
  flit2.negocio.core_personanatural -> flit2.datos.db 'Su esquema'
  flit2.negocio.core_ict -> flit2.datos.db 'Su esquema [por verificar]'
  flit2.negocio.migracion_api -> flit2.datos.db 'Escribe lo migrado'

  // ── Bus (contracts/asyncapi) ─────────────────────────────
  flit2.negocio.core_api -[async]-> flit2.datos.bus 'Publica tramites.* y trabajos de notificación'
  flit2.plataforma.core_identity -[async]-> flit2.datos.bus 'Publica platform.*'
  flit2.plataforma.core_consultas -[async]-> flit2.datos.bus 'Publica consultas.*'
  flit2.negocio.core_diagnostico -[async]-> flit2.datos.bus 'Publica diagnostico.* y pide consultas'
  flit2.negocio.core_personanatural -[async]-> flit2.datos.bus 'Publica la solicitud de radicación'
  flit2.datos.bus -[async]-> flit2.plataforma.core_notificaciones 'Trabajos de correo y webhook'
  flit2.datos.bus -[async]-> flit2.negocio.core_api 'platform.*, consultas.* y radicaciones'
  flit2.datos.bus -[async]-> flit2.plataforma.core_consultas 'Trabajos de consulta del Diagnóstico'
  flit2.datos.bus -[async]-> flit2.negocio.core_diagnostico 'Resultados de consulta'
  flit2.datos.bus -[async]-> flit2.negocio.core_personanatural 'Resolución y estado del trámite'

  // ── Webhooks salientes (domain-events.v1.yaml) ───────────
  flit2.plataforma.core_notificaciones -[async]-> flito 'Aviso tramite.cambio (firmado)'
  flit2.plataforma.core_notificaciones -[async]-> usuarios.organismo 'Webhook de estado al organismo'

  // ── Externos ─────────────────────────────────────────────
  flit2.negocio.core_api -> fuentes.verifik 'RUNT, SIMIT, RUES y RNMC'
  flit2.negocio.core_api -> fuentes.kyverum 'RUNT, comparendos, verificación y certificados'
  flit2.negocio.core_api -> fuentes.intempo 'Consulta RUNT'
  flit2.negocio.core_api -> fuentes.rues 'Consulta empresa'
  flit2.negocio.core_api -> entidades.quipux 'Bandeja de organismos'
  flit2.negocio.core_api -> terceros.ado 'Casos de soporte de Dr. FLIT'
  flit2.negocio.core_api -> terceros.llm 'OCR y Dr. FLIT (router de IA)' {
    #ia
  }
  flit2.negocio.core_api -> terceros.objstore 'S3'
  flit2.negocio.core_api -> satelites.file_manager 'Adjuntos'
  fuentes.kyverum -[async]-> flit2.gateway 'Webhooks (/api/v1/webhooks y avisos)'
  terceros.idsecure -> flit2.gateway '/api/public/idsecure [por verificar]'
  flit2.plataforma.core_consultas -> fuentes.verifik 'SIMIT'
  flit2.plataforma.core_consultas -> fuentes.kyverum 'RUNT y verificación [por verificar]'
  flit2.plataforma.core_consultas -> fuentes.intempo 'RUNT'
  flit2.plataforma.core_consultas -> satelites.egress 'Una fuente de comparendos sale por el proxy'
  flit2.negocio.core_comparendos -> terceros.llm 'OCR de comparendos' {
    #ia
  }
  flit2.negocio.core_comparendos -> satelites.file_manager 'Evidencias'
  flit2.negocio.core_diagnostico -> terceros.llm 'Redacción del dictamen' {
    #ia
  }
  flit2.negocio.core_diagnostico -> satelites.file_manager 'Documentos'
  flit2.negocio.core_personanatural -> satelites.file_manager 'Adjuntos de la solicitud'
  flit2.plataforma.core_notificaciones -> terceros.correo 'SMTP'
}
