<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Servicio de plataforma core-consultas (consultas de servicio, Epic #13316, HU #13340). Nace con el SDK de plataforma:
    tokens por JWKS, gRPC con token de servicio, outbox e inbox en su esquema propio, salud REST y grpc.health.v1.
    Guía: docs/suite/servicio-nuevo.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Flit.Consultas.Api</RootNamespace>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core-api\src\Flit.Platform.Sdk\Flit.Platform.Sdk.csproj" />
    <!-- HU #13343: proveedores, cadena de respaldo y avalúos (ADR-0065). -->
    <ProjectReference Include="..\..\..\core-api\src\Flit.Modules.Consultas\Flit.Modules.Consultas.csproj" />
    <ProjectReference Include="..\Flit.Consultas.Grpc.Contracts\Flit.Consultas.Grpc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flit.Consultas.Tests" />
  </ItemGroup>

</Project>
