# Plantilla para el OCR semántico de documentos de trámites (Anthropic Messages API).
# Copia este archivo a .env.anthropic y rellena los valores reales.
# .env.anthropic está gitignored (.gitignore: .env.*); este .example sí se commitea.
#
# NOTA IMPORTANTE — cómo se cargan estas variables:
#   - DOCKER (docker-compose): se inyectan como variables de entorno del contenedor.
#   - LOCAL (dotnet run / watch): ASP.NET Core NO lee archivos .env. Para correr en local,
#     define los valores en services/core-api/src/Flit.Api/appsettings.Development.json
#     (sección "Ocr" y "Anthropic", también gitignored) o expórtalos en tu shell antes de arrancar.

# Activa el proveedor real (default 'mock' devuelve fixtures y no llama a Anthropic).
OCR_PROVIDER=anthropic

# API key de Anthropic. Solo el token (empieza por sk-ant-...).
ANTHROPIC_API_KEY=REEMPLAZAR_CON_API_KEY_VIGENTE

# Opcional: modelo de visión (default claude-haiku-4-5-20251001).
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Opcional: URL base de la API (default https://api.anthropic.com).
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Opcional: timeout por defecto en segundos.
# ANTHROPIC_TIMEOUT_SECONDS=60

# Opcional: máximo de tokens de salida por análisis.
# ANTHROPIC_MAX_TOKENS=2000
