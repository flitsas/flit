# Configuración del laboratorio del migrador. Copiar a lab.env (ignorado por git) y ajustar.
# Todo lo que apunte a una base de datos DEBE ser local: el script se niega a otra cosa.

# Postgres local donde viven la copia de V1 y el laboratorio de V2.
LAB_PG_HOST=localhost
LAB_PG_PORT=5432
LAB_PG_USER=postgres
LAB_PG_PASSWORD=

# Copia de V1 de producción (solo lectura).
LAB_V1_DB=pdn_copy_updated

# Base de V2 del laboratorio, y la base de dev de la que se clona (trae el catálogo de organismos).
LAB_V2_DB=flit_migrador_lab
LAB_V2_TEMPLATE_DB=flitdev_vps_migrado

# Repositorio de V1 (BackCrudTransfer) y puerto en que el script lo levanta.
LAB_V1_REPO=$HOME/Desktop/work/Flit/repos/BackCrudTransfer_master
LAB_V1_PORT=3201

# Servicio de PDF de V1 (gRPC) y el Chrome que usa para renderizar.
LAB_PDF_REPO=$HOME/Desktop/work/Flit/repos/BackSrvPdfService
LAB_PDF_PORT=4601
LAB_CHROME_PATH="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# File-manager ORIGEN: el del mismo ambiente que la copia de V1 (producción). No pide token.
LAB_SOURCE_FM_URL=https://ny46zhyeti.execute-api.us-east-1.amazonaws.com/pdn/

# File-manager DESTINO de V2 (MinIO de dev).
LAB_TARGET_FM_URL=https://devfilemanager.flitsas.online/

# Etiqueta del lote en migration_map: permite auditar y revertir por tanda.
LAB_BATCH_ID=lab-entregados
