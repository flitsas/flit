{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["https://flit.co", "https://app.flit.co", "http://localhost:4001"]
  },
  "Jwt": {
    "Issuer": "https://api.flit.co",
    "Audience": "flit-api",
    "PublicKeyPem": ""
  },
  "RateLimit": {
    "PerIpPermitsPerMinute": 600,
    "PerUserPermitsPerMinute": 1200,
    "LoginEndpointPermitsPerMinute": 10
  },
  "ReverseProxy": {
    "Routes": {
      "swagger-ui-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/swagger" }
      },
      "swagger-assets-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/swagger/{**catch-all}" }
      },
      "core-api-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/api/{**catch-all}" }
        ],
        "AuthorizationPolicy": "JwtRequired"
      },
      "signalr-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/hubs/{**catch-all}" },
        "AuthorizationPolicy": "JwtRequired"
      },
      "auth-public-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/v1/auth/{**catch-all}" }
      },
      "kyverum-webhook-public-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/v1/webhooks/{**catch-all}" }
      },
      "idsecure-public-api-route": {
        "ClusterId": "core-api-cluster",
        "Match": { "Path": "/api/public/idsecure/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/public/idsecure/{**catch-all}" }
        ]
      },
      "ml-route": {
        "ClusterId": "python-ml-cluster",
        "Match": { "Path": "/ml/{**catch-all}" },
        "Transforms": [
          { "PathPattern": "/{**catch-all}" }
        ],
        "AuthorizationPolicy": "JwtRequired"
      },
      "ict-host-route": {
        "ClusterId": "core-ict-cluster",
        "Order": -100,
        "Match": {
          "Hosts": ["ict.flitsas.com", "ict.dev.flitsas.com", "ict.qa.flitsas.com", "ict.localhost"],
          "Path": "/{**catch-all}"
        }
      },
      "ict-admin-route": {
        "ClusterId": "core-ict-cluster",
        "Match": { "Path": "/api/v1/ict/{**catch-all}" },
        "AuthorizationPolicy": "JwtRequired"
      },
      "migracion-route": {
        "ClusterId": "migracion-cluster",
        "Match": { "Path": "/api/v1/migracion/{**catch-all}" }
      },
      // Mismo caso que migracion-route: el cargue masivo de OCR no cabe en los 30 s de
      // core-api-cluster. La ruta es mas especifica que la de core-api, asi que gana por
      // precedencia de routing sin necesidad de Order (igual que migracion-route).
      "ocr-route": {
        "ClusterId": "core-api-ocr-cluster",
        "Match": { "Path": "/api/v1/tramites/ocr/{**catch-all}" },
        "AuthorizationPolicy": "JwtRequired"
      }
    },
    "Clusters": {
      "core-api-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "core-api-1": { "Address": "http://core-api:4003/" }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      "python-ml-cluster": {
        "Destinations": {
          "python-ml-1": { "Address": "http://python-ml:4012/" }
        },
        "HttpRequest": { "ActivityTimeout": "00:01:00" }
      },
      "core-ict-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "core-ict-1": { "Address": "http://core-ict:4020/" }
        },
        "HttpRequest": { "ActivityTimeout": "00:00:30" }
      },
      // Migrador V1 -> V2. Cluster PROPIO a proposito: una migracion de instancia 3
      // (snapshot de PDFs + subidas de 9-12 MB) tarda mucho mas de 30 s, y bajo el
      // ActivityTimeout de core-api el gateway devolveria 504 sobre migraciones que SI
      // se completaron. En YARP el timeout es por cluster, asi que subirlo aqui no toca
      // el resto del trafico. NO mover esta ruta a core-api-cluster.
      // Puerto interno FIJO 4030 en los tres ambientes: no publica puerto en el host,
      // asi que no puede chocar con nada y no necesita variable de entorno.
      "migracion-cluster": {
        "Destinations": {
          "migracion-api-1": { "Address": "http://migracion-api:4030/" }
        },
        "HttpRequest": { "ActivityTimeout": "00:30:00" }
      },
      // Cargue masivo de OCR (POST /api/v1/tramites/ocr/lote). Mismo destino que
      // core-api-cluster pero con su propio timeout: AnalyzeBatchHandler admite 20
      // archivos, los procesa EN SERIE y cada uno gasta una llamada al clasificador
      // (ClassifierTimeoutSeconds = 180), asi que un lote grande tarda minutos. Con los
      // 30 s de core-api-cluster el gateway devolvia 504 sobre lotes que seguian
      // corriendo, y el operador perdia todo el OCR ya pagado.
      //
      // ActivityTimeout es de INACTIVIDAD, no de duracion total: no ralentiza nada sano,
      // solo tarda mas en dar por muerta una peticion colgada.
      //
      // A diferencia de migracion-api (puerto interno fijo 4030), core-api escucha en un
      // puerto distinto por ambiente, asi que este destino SI necesita su variable de
      // entorno en docker-compose.prod.yml, junto a la de core-api-cluster.
      "core-api-ocr-cluster": {
        "Destinations": {
          "core-api-1": { "Address": "http://core-api:4003/" }
        },
        "HttpRequest": { "ActivityTimeout": "00:10:00" }
      }
    }
  }
}
