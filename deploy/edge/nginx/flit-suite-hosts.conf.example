# deploy/edge/nginx/flit-suite-hosts.conf.example
#
# FLIT Suite (A-11, HU #13002) — el hub ocupa la raíz de cada ambiente y Trámites pasa a su propio host
# (plan maestro §4.3). Plantilla para el nginx EXTERNO del VPS; el nginx real no se toca desde este repo.
# Ejemplo para DEV; en QA y PDN cambian los hosts y los puertos (HUB_PORT 4022/5022/6022, FRONTEND_PORT 4001/5001/6001,
# IMPUESTOS_PORT 4034/5034/6034, GATEWAY_PORT 4002/5002/6002).
#
# ORDEN PARA ENCENDERLO EN UN AMBIENTE (y cómo volver atrás):
#   1. DNS y certificado de dev.tramites.flitsas.online (mismo VPS).
#   2. En el .env: COMPOSE_PROFILES=suite, FLIT_SESSION_SECRET, FLIT_OIDC_ENABLED=true,
#      FLIT_SESSION_MODE=oidc y FLIT_TRAMITES_HOST_ENABLED=true. Recrear contenedores (el CD o `docker compose up -d`).
#   3. Agregar el server{} de dev.tramites.flitsas.online de abajo y, en el server{} que HOY sirve dev.flitsas.online,
#      cambiar proxy_pass del puerto del frontend (FRONTEND_PORT) al del hub (HUB_PORT). nginx -t && nginx -s reload.
#   Volver atrás: proxy_pass de dev.flitsas.online otra vez a FRONTEND_PORT, FLIT_SESSION_MODE=legacy y
#   FLIT_TRAMITES_HOST_ENABLED=false en el .env. Los usuarios inician sesión una vez más.
#
# QUÉ VA A CADA CONTENEDOR: todo. El hub reenvía él mismo /api/v1, /connect y /.well-known al gateway (con el sello
# de dominio y, en /api/v1, el Bearer de la sesión); Trámites en modo oidc hace lo mismo con /api/v1 (BFF). El borde
# ya no necesita locations separadas para la API en estos dos hosts. api.dev.flitsas.online sigue igual.

# ── Trámites en su host ─────────────────────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name dev.tramites.flitsas.online;

    ssl_certificate     /etc/letsencrypt/live/dev.tramites.flitsas.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.tramites.flitsas.online/privkey.pem;

    # Las consultas RUNT/SIMIT del pre-vuelo tardan 8-10 s y las migraciones más: mismo valor que el server{} actual.
    proxy_read_timeout 60s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 50m;

    # HU #13379 — partes del lote de consolidados en streaming (hasta ~250 MB). En este host la API va por el BFF de
    # Trámites (modo oidc: el middleware reescribe /api/v1/* a /bff/api/v1/*, que reenvía al gateway con el Bearer de
    # la sesión del servidor y devuelve el cuerpo en streaming). Por eso esta location va al FRONTEND y no al gateway:
    # directo al gateway la petición llegaría sin Bearer (el navegador no tiene el token) y respondería 401.
    # Lo único que cambia frente a `location /` es que nginx no bufferiza: sin esto volcaría la parte a su temp file
    # del VPS antes de entregarla. Regex: gana sobre `location /`. Hereda los proxy_set_header del server{}.
    location ~ ^/api/v1/consolidados/lotes/[^/]+/partes/[0-9]+$ {
        proxy_pass http://127.0.0.1:4001;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://127.0.0.1:4001;
    }
}

# ── Hub en la raíz (reemplaza el destino del server{} actual de dev.flitsas.online) ─
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name dev.flitsas.online;

    ssl_certificate     /etc/letsencrypt/live/dev.flitsas.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.flitsas.online/privkey.pem;

    proxy_read_timeout 60s;
    proxy_http_version 1.1;
    # El hub arma el sello X-Flit-Domain con este Host: tiene que llegar tal cual.
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:4022;
    }
}

# ── Impuestos en su host (HU #14694, ADR-0093) ─────────────────────────────
# App web frontend-impuestos en IMPUESTOS_PORT (DEV 4034 / QA 5034 / PDN 6034); el gateway en GATEWAY_PORT
# (4002 / 5002 / 6002). Host <amb>.impuestos.flitsas.online (impuestos.flitsas.online en PDN), el mismo que arma el
# hub para el cliente OIDC `impuestos` (Suite:Hosts). Pasos y orden en docs/suite/handoff-vps-impuestos.md §8.
#
# Receptor de avisos del API de liquidación (gate G-6): el API llama por POST a
# IMPUESTOS_SVC_AVISOS_URL_BASE/<token> sin seguir redirecciones y sin Bearer (la credencial es la firma HMAC). Si ese
# host público es este, /api/v1/impuestos/avisos/ va DIRECTO al gateway: por la app web pasaría por su BFF, que exige
# la sesión. Si el host público elegido es api.<amb>.flitsas.online, esa location no hace falta (ese host ya va entero
# al gateway), pero sigue sin poder redirigir de http a https ni de un host a otro.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name dev.impuestos.flitsas.online;

    ssl_certificate     /etc/letsencrypt/live/dev.impuestos.flitsas.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/dev.impuestos.flitsas.online/privkey.pem;

    proxy_read_timeout 60s;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    # Carga masiva de placas (plantilla Excel): mismo margen que los demás hosts.
    client_max_body_size 50m;

    # Avisos firmados del API de liquidación: al gateway, sin redirecciones y sin tocar el cuerpo (la firma se calcula
    # sobre los bytes exactos). Hereda los proxy_set_header del server{}.
    location /api/v1/impuestos/avisos/ {
        proxy_pass http://127.0.0.1:4002;
        proxy_redirect off;
    }

    location / {
        proxy_pass http://127.0.0.1:4034;
    }
}
