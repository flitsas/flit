{
  "openapi": "3.0.3",
  "info": {
    "title": "FLIT — API externa de sincronización de trámites",
    "version": "3.1.0",
    "description": "Contrato para clientes de integración externos (primer consumidor: Flito), Épica #12737. Solo pull: el consumidor recorre el feed por cursor cada 5 minutos y a demanda. Todos los ejemplos usan datos ficticios. La guía de consumo (orden de llamadas, arranque sin histórico, reintentos) está en docs/integraciones/external-api-tramites-sync.md §5.",
    "contact": {
      "name": "Equipo FLIT"
    },
    "license": {
      "name": "Uso restringido a clientes de integración autorizados por FLIT"
    }
  },
  "externalDocs": {
    "description": "Contrato v3.1 y guía de consumo",
    "url": "https://github.com/flitsas/flit/blob/develop/docs/integraciones/external-api-tramites-sync.md"
  },
  "servers": [
    {
      "url": "https://{host}",
      "description": "Un host y un cliente por ambiente (DEV, QA, PDN).",
      "variables": {
        "host": {
          "default": "api.flitsas.com",
          "description": "Host de la API del ambiente."
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Autenticación",
      "description": "Canje de credenciales por un pase de acceso."
    },
    {
      "name": "Sincronización",
      "description": "Feed de trámites por cursor y descarga de la factura."
    }
  ],
  "security": [
    {
      "externalClient": []
    }
  ],
  "paths": {
    "/api/v1/external/auth/token": {
      "post": {
        "tags": [
          "Autenticación"
        ],
        "operationId": "obtenerPase",
        "summary": "Obtener un pase de acceso",
        "description": "Limitado a 10 solicitudes por minuto por IP. Tras 5 fallos seguidos el cliente queda bloqueado 15 minutos.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequest"
              },
              "example": {
                "clientId": "flito-qa",
                "clientSecret": "secreto-de-ejemplo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pase emitido. Cache-Control: no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                },
                "example": {
                  "accessToken": "<pase JWT de ejemplo>",
                  "tokenType": "Bearer",
                  "expiresIn": 1800,
                  "scope": [
                    "external.tramites.read",
                    "external.tramites.pii.read"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Credenciales inválidas o cliente inactivo (no se revela cuál).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "invalid_client": {
                    "value": {
                      "type": "about:blank",
                      "title": "invalid_client",
                      "status": 401,
                      "detail": "Credenciales de cliente inválidas.",
                      "code": "invalid_client"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "El cliente debe rotar su secreto.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "secret_rotation_required": {
                    "value": {
                      "type": "about:blank",
                      "title": "secret_rotation_required",
                      "status": 403,
                      "detail": "El cliente debe rotar su secreto antes de obtener un pase.",
                      "code": "secret_rotation_required"
                    }
                  }
                }
              }
            }
          },
          "423": {
            "description": "Cliente bloqueado por intentos fallidos.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "client_locked": {
                    "value": {
                      "type": "about:blank",
                      "title": "client_locked",
                      "status": 423,
                      "detail": "Cliente bloqueado temporalmente por intentos fallidos.",
                      "code": "client_locked"
                    }
                  }
                }
              }
            },
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "429": {
            "description": "Más de 10 solicitudes de pase por minuto desde la misma IP.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "rate_limited": {
                    "value": {
                      "type": "about:blank",
                      "title": "rate_limited",
                      "status": 429,
                      "detail": "Demasiadas solicitudes. Reintente después de Retry-After.",
                      "code": "rate_limited"
                    }
                  }
                }
              }
            },
            "headers": {
              "Retry-After": {
                "$ref": "#/components/headers/RetryAfter"
              }
            }
          },
          "503": {
            "description": "El ambiente no tiene llave de emisión.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                },
                "examples": {
                  "external_auth_unavailable": {
                    "value": {
                      "type": "about:blank",
                      "title": "external_auth_unavailable",
                      "status": 503,
                      "detail": "La emisión de pases externos no está disponible.",
                      "code": "external_auth_unavailable"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/external/tramites/sync": {
      "get": {
        "tags": [
          "Sincronización"
        ],
        "operationId": "sincronizarTramites",
        "summary": "Recorrer el feed de trámites",
        "description": "Entrega los trámites radicados al menos una vez (nunca los migrados desde FLIT 1), en el orden del cursor, con una ventana de estabilidad de 5 segundos. Upsert por id descartando syncVersion ≤ la guardada. Exige external.tramites.read; sin external.tramites.pii.read los campos x-pii llegan enmascarados.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "nextCursor de la página anterior. Excluyente con since.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO-8601 con zona (Z o ±hh:mm). Arranca desde la fecha de último cambio. Excluyente con cursor.",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "example": "2026-09-21T10:15:00-05:00"
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Entre 1 y 1000.",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 200,
              "minimum": 1,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página. Cache-Control: no-store.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncPage"
