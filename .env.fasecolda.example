# Fasecolda — proveedor de avalúo comercial (Feature #10707)
# Copia a .env.fasecolda (gitignored) o expórtalas en el shell / inyéctalas en Docker.
# En local, ASP.NET Core NO lee archivos .env: usa User Secrets o appsettings.Development.json
# (gitignored), o variables de entorno del proceso.
#
# Modo del proveedor: "mock" (default, lee tramites.avaluo_mock_values) o "real".
FASECOLDA_MODE=mock
#
# Solo se usan en modo real. NO commitear credenciales reales. Rotar las que estuvieron expuestas.
FASECOLDA_BY_VIN_API_BASE_URL=https://fasecoldaback.quantil.co
FASECOLDA_BY_VIN_API_PATH=/api/busquedaVin
FASECOLDA_API_BASE_URL=https://guiadevalores.fasecolda.com/apifasecolda
FASECOLDA_AUTH_API_PATH=/token
FASECOLDA_LIST_CODE_API_PATH=/api/listacodigosid/consultabycodigo
FASECOLDA_API_GRANT_TYPE=password
FASECOLDA_API_USERNAME=
FASECOLDA_API_PASSWORD=
FASECOLDA_API_SECONDS_TIMEOUT=55
