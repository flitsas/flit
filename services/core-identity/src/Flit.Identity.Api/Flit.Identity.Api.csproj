<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Epic #13217 (HU #13233) — core-identity: el servicio de identidad de la FLIT Suite. Login (el de siempre y OIDC del
    hub), recuperación de cuenta, productos de la empresa y marca pública. Mismo Postgres que core-api, sin migraciones
    propias (las corre core-api). Su cierre de dependencias NO incluye Flit.Infrastructure ni Trámites: lo verifica
    Flit.Identity.Tests (BuildClosureTests).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Flit.Identity.Api</RootNamespace>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flit.Identity.Web\Flit.Identity.Web.csproj" />
    <!-- Epic #13316 (HU #13334): servidor gRPC de Identidad. Va aquí y no en Flit.Identity.Web, que core-api todavía
         referencia: así la imagen de core-api no necesita contracts/proto. -->
    <ProjectReference Include="..\Flit.Identidad.Grpc.Contracts\Flit.Identidad.Grpc.Contracts.csproj" />
  </ItemGroup>

  <!--
    La configuración base es la MISMA de core-api (enlazada, no copiada): emisor y audiencia del JWT, ids de las llaves
    de firma, clientes OIDC, duraciones de sesión, correo. Si los dos procesos difirieran, uno rechazaría los tokens del
    otro. Lo propio de cada ambiente llega por variables (el compose comparte el bloque con un ancla).
  -->
  <ItemGroup>
    <Content Include="..\..\..\core-api\src\Flit.Api\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Condition="Exists('..\..\..\core-api\src\Flit.Api\appsettings.Development.json')" Include="..\..\..\core-api\src\Flit.Api\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flit.Identity.Tests" />
  </ItemGroup>

</Project>
