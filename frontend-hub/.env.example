# Hub de la suite en tu máquina (docs/suite/local.md, sección 2). Copia este archivo a .env.local (ignorado por git).
# Son las mismas variables del comando de la guía; abre siempre http://127.0.0.1:4022, nunca localhost.

# El puerto (4022) lo fija el script `dev` de package.json.
# La API que firma el login (core-api; con core-identity aparte, http://127.0.0.1:4025).
CORE_API_ORIGIN=http://127.0.0.1:4003
BRANDING_INTERNAL_API_URL=http://127.0.0.1:4003
# Dónde vive el propio hub y dónde vive Trámites (para las redirecciones del login y el menú de productos).
FLIT_HUB_URL=http://127.0.0.1:4022
TRAMITES_URL=http://127.0.0.1:3000
