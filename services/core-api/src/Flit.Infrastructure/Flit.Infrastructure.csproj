<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Flit.Infrastructure</RootNamespace>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!-- CA1861: arrays constantes en config EF.
         CA1304/CA1310/CA1311/CA1862: las consultas EF Core deben usar overloads
         sin StringComparison para que Npgsql las traduzca a SQL (lower()/LIKE). -->
    <NoWarn>$(NoWarn);CA1861;CA1304;CA1310;CA1311;CA1862</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Sql\Ddl\*.sql" />
    <EmbeddedResource Include="Documents\Fur\fur-field-manifest*.json" />
    <!-- HU #10256 fix — fuentes embebidas para el resolutor de PdfSharpCore (overlay del FUR).
         PdfSharpCore no trae fuentes y resuelve contra el SO; el runtime aspnet:10.0-alpine no
         tiene ninguna, por lo que XFont("Arial", ...) lanzaba y el endpoint respondía HTTP 500.
         DejaVu Sans (licencia Bitstream Vera/Arev, ver Documents/Fur/Fonts/DejaVu-LICENSE.txt). -->
    <EmbeddedResource Include="Documents\Fur\Fonts\*.ttf" />
    <Content Include="Documents\Fur\Templates\*.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flit.Admin.Application\Flit.Admin.Application.csproj" />
    <ProjectReference Include="..\Flit.Analytics.Application\Flit.Analytics.Application.csproj" />
    <ProjectReference Include="..\Flit.Tramites.Application\Flit.Tramites.Application.csproj" />
    <ProjectReference Include="..\Flit.Modules.Security.Application\Flit.Modules.Security.Application.csproj" />
    <ProjectReference Include="..\Flit.Modules.Security.Domain\Flit.Modules.Security.Domain.csproj" />
    <ProjectReference Include="..\Flit.Admin.Domain\Flit.Admin.Domain.csproj" />
    <ProjectReference Include="..\Flit.Modules.Improntas.Domain\Flit.Modules.Improntas.Domain.csproj" />
    <ProjectReference Include="..\Flit.Modules.Quipux.Application\Flit.Modules.Quipux.Application.csproj" />
    <ProjectReference Include="..\Flit.Modules.Quipux.Domain\Flit.Modules.Quipux.Domain.csproj" />
    <!-- Quipux: el PDF consolidado se publica en el bucket S3 DE QUIPUX (qxinterconnect), que lee
         el documento de ahí — por eso el payload de radicación lleva la key y no el binario. Es el
         único punto de FLIT 2.0 con credenciales AWS directas: el File Manager corporativo no
         aplica porque el bucket es de un tercero. -->
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flit.Admin.Tests" />
    <InternalsVisibleTo Include="Flit.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <!-- HU #10256 — generador PDF real del FUR (QuestPDF Community). Versión pineada en Directory.Packages.props. -->
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="PdfSharpCore" />
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="System.IO.Packaging" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

</Project>
