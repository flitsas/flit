# RUNT por Intempo, API nativa de core-consultas (HU F10-H4, #13876; Feature F10 «RUNT real por Intempo»)
# Copia a .env.intempo (gitignored) o inyéctalas en el contenedor / el .env del ambiente.
# En local, ASP.NET Core NO lee archivos .env: usa User Secrets, appsettings.Development.json
# (gitignored) o variables de entorno del proceso.
#
# NO COMMITEAR VALORES REALES. La URL base va vacía a propósito.
#
# ---------------------------------------------------------------------------------------------
# LEE ESTO ANTES DE ENCENDER LA FUENTE
# ---------------------------------------------------------------------------------------------
# El endpoint de Intempo NO tiene autenticación: quien conoce la URL consulta el RUNT. Por eso la
# URL real no vive en el repositorio; el valor lo entrega el Líder Técnico fuera del repo y cada
# ambiente lo define en su propio .env. Es la misma URL en DEV, QA y PDN.
#
# Sin INTEMPO_API_BASE_URL (o con un valor que no es una URL http/https absoluta) la fuente queda
# «no conectada»: core-consultas arranca igual y los rpcs ConsultarPorPlaca / ConsultarPorVin de
# RuntIntempoService responden FAILED_PRECONDITION nombrando la variable (nunca su valor).
#
# Antes de definirla en un ambiente, corre la prueba de humo desde local (imprime solo status,
# duración, bytes y el árbol de claves y tipos; nunca valores ni la URL):
#   INTEMPO_API_BASE_URL=<url> python -I scripts/smoke/humo-intempo.py <placa>
#   INTEMPO_API_BASE_URL=<url> python -I scripts/smoke/humo-intempo.py <vin> --vin
# Su salida no va a ADO, logs ni commits.
#
# INTEMPO_MODE / INTEMPO_BASE_URL son del proveedor heredado de core-api y no tienen relación
# con este bloque.
# ---------------------------------------------------------------------------------------------

# URL base (sin barra final). Sin valor por defecto: vacía = no conectada.
INTEMPO_API_BASE_URL=

# Rutas de la consulta por placa (?Plate=) y por VIN (?Vin=). Defecto de la especificación.
INTEMPO_API_VEHICLE_PLATE_PATH=/api/RuntConsulta/consultar-vehiculo
INTEMPO_API_VEHICLE_VIN_PATH=/api/RuntConsulta/consultar-vin

# Timeout de cada consulta, en segundos (entero > 0; otro valor cae al defecto 20).
INTEMPO_API_SECONDS_TIMEOUT=20
