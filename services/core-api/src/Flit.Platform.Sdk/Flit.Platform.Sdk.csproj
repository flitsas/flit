<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Epic #13316 (HU #13336, ADR-0070) — SDK de plataforma: lo que cualquier servicio de FLIT necesita para atender y
    llamar a otros sin infraestructura propia. Hoy: correlación y telemetría, constantes de tokens y autorización,
    contexto de empresa que falla cerrado y validación de tokens por JWKS. Los siguientes pasos (gRPC, outbox,
    consumidor) llegan con las HUs #13337-#13339.

    Regla: NO referencia ningún proyecto Flit. Un servicio nuevo (core-consultas, core-notificaciones) no puede
    arrastrar la base de Identidad ni Trámites. Lo que lee la base de Identidad (llave de firma, emisores por dominio)
    sigue en Flit.Suite.AspNetCore, que referencia este SDK. Los tipos que salieron de ahí conservan su espacio de
    nombres Flit.Api.* para que nadie más cambie.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Flit.Platform.Sdk</RootNamespace>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <!-- HU #13337: servidor y clientes gRPC entre servicios. -->
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.StatusProto" />
    <PackageReference Include="Grpc.AspNetCore.HealthChecks" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flit.Suite.AspNetCore" />
    <InternalsVisibleTo Include="Flit.Api" />
    <InternalsVisibleTo Include="Flit.Identity.Web" />
    <InternalsVisibleTo Include="Flit.Identity.Api" />
    <InternalsVisibleTo Include="Flit.Admin.Tests" />
    <InternalsVisibleTo Include="Flit.Infrastructure.Tests" />
    <InternalsVisibleTo Include="Flit.Integration.Tests" />
    <InternalsVisibleTo Include="Flit.Identity.Tests" />
    <InternalsVisibleTo Include="Flit.Platform.Sdk.Tests" />
  </ItemGroup>

</Project>
