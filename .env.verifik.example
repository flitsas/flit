# Plantilla para credenciales del proveedor Verifik (RUNT Colombia)
# Copia este archivo a .env.verifik y rellena los valores reales.
# El archivo .env.verifik está gitignored; este .example sí se commitea.

# URL base de la API
VERIFIK_BASE_URL=https://api.verifik.co

# Access Token de https://app.verifik.co (API Keys / perfil). Solo el JWT, sin "Bearer ".
# Debe funcionar en: GET https://api.verifik.co/v2/co/runt/conductor?documentType=CC&documentNumber=...
VERIFIK_API_TOKEN=REEMPLAZAR_CON_ACCESS_TOKEN_VIGENTE

# Opcional: Bearer (default) o jwt
# VERIFIK_AUTH_SCHEME=Bearer

# Timeout por defecto en segundos para las requests
VERIFIK_TIMEOUT_SECONDS=30

# API local (Postman): http://localhost:3030/api/v1/traspasos/consultas/
#   vehiculo | conductor | rnmc | rues | simit | status
# Diagnóstico: backend/dotnet/scripts/test-verifik-connection.ps1
