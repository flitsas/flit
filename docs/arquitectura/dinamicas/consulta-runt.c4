views {
  // V13. Fuente: contracts/proto/flit/consultas/v1, RuntIntempo y Comparendos en core-consultas, ConsultasRemotasDecoradores
  // en core-api. core-api también tiene proveedores locales: cuál camino rige en cada ambiente es [por verificar].
  dynamic view flujo_consulta_runt {
    title 'Consulta del RUNT'
    description 'Por gRPC hacia core-consultas. Proveedor que atiende cada fuente en cada ambiente: [por verificar].'
    flit2.negocio.core_api -> flit2.plataforma.core_consultas 'ConsultasService (gRPC)'
    flit2.plataforma.core_consultas -> fuentes.intempo 'Consulta RUNT'
    flit2.plataforma.core_consultas -> fuentes.kyverum 'Respaldo [por verificar]'
    flit2.plataforma.core_consultas -> flit2.datos.db 'Guarda la consulta'
    flit2.plataforma.core_consultas -> flit2.datos.bus 'consultas.consulta.realizada'
    autoLayout TopBottom 45 25
  }
}
