{
  "rabbit_version": "4.1",
  "vhosts": [{ "name": "flit" }],
  "exchanges": [
    { "name": "flit.plataforma", "vhost": "flit", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "flit.tramites", "vhost": "flit", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "flit.consultas", "vhost": "flit", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "flit.notificaciones", "vhost": "flit", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} },
    { "name": "flit.diagnostico", "vhost": "flit", "type": "topic", "durable": true, "auto_delete": false, "internal": false, "arguments": {} }
  ],
  "queues": [
    { "name": "consultas.diagnostico", "vhost": "flit", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "consultas.diagnostico-express", "vhost": "flit", "durable": true, "auto_delete": false, "arguments": {} },
    { "name": "diagnostico.consultas-resultados", "vhost": "flit", "durable": true, "auto_delete": false, "arguments": {} }
  ],
  "bindings": [
    { "source": "flit.consultas", "vhost": "flit", "destination": "consultas.diagnostico", "destination_type": "queue", "routing_key": "consultas.diagnostico.*", "arguments": {} },
    { "source": "flit.consultas", "vhost": "flit", "destination": "consultas.diagnostico-express", "destination_type": "queue", "routing_key": "consultas.diagnostico-express.*", "arguments": {} },
    { "source": "flit.consultas", "vhost": "flit", "destination": "diagnostico.consultas-resultados", "destination_type": "queue", "routing_key": "consultas.resultado.diagnostico", "arguments": {} }
  ],
  "users": [],
  "permissions": [],
  "policies": [
    {
      "vhost": "flit",
      "name": "dlq-7d",
      "pattern": "^(consultas\\.diagnostico|consultas\\.diagnostico-express|diagnostico\\.consultas-resultados)\\.dlq$",
      "apply-to": "queues",
      "priority": 10,
      "definition": { "message-ttl": 604800000 }
    },
    {
      "vhost": "flit",
      "name": "ttl-consultas-diagnostico",
      "pattern": "^consultas\\.diagnostico$",
      "apply-to": "queues",
      "priority": 10,
      "definition": { "message-ttl": 86400000, "dead-letter-exchange": "consultas.diagnostico.reintentos", "dead-letter-routing-key": "consultas.diagnostico.dlq" }
    },
    {
      "vhost": "flit",
      "name": "ttl-consultas-diagnostico-express",
      "pattern": "^consultas\\.diagnostico-express$",
      "apply-to": "queues",
      "priority": 10,
      "definition": { "message-ttl": 86400000, "dead-letter-exchange": "consultas.diagnostico-express.reintentos", "dead-letter-routing-key": "consultas.diagnostico-express.dlq" }
    },
    {
      "vhost": "flit",
      "name": "ttl-diagnostico-consultas-resultados",
      "pattern": "^diagnostico\\.consultas-resultados$",
      "apply-to": "queues",
      "priority": 10,
      "definition": { "message-ttl": 86400000, "dead-letter-exchange": "diagnostico.consultas-resultados.reintentos", "dead-letter-routing-key": "diagnostico.consultas-resultados.dlq" }
    }
  ]
}
