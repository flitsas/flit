<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Flit.Infrastructure</RootNamespace>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <NuGetAuditMode>direct</NuGetAuditMode>
    <!-- CA1861: arrays constantes en config EF.
         CA1304/CA1310/CA1311/CA1862: las consultas EF Core deben usar overloads
         sin StringComparison para que Npgsql las traduzca a SQL (lower()/LIKE). -->
    <NoWarn>$(NoWarn);CA1861;CA1304;CA1310;CA1311;CA1862</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Sql\Ddl\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flit.Admin.Application\Flit.Admin.Application.csproj" />
    <ProjectReference Include="..\Flit.Tramites.Application\Flit.Tramites.Application.csproj" />
    <ProjectReference Include="..\Flit.Modules.Security.Application\Flit.Modules.Security.Application.csproj" />
    <ProjectReference Include="..\Flit.Modules.Security.Domain\Flit.Modules.Security.Domain.csproj" />
    <ProjectReference Include="..\Flit.Admin.Domain\Flit.Admin.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flit.Admin.Tests" />
    <InternalsVisibleTo Include="Flit.Infrastructure.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" />
    <!-- HU #10256 — generador PDF real del FUR (QuestPDF Community). Versión pineada en Directory.Packages.props. -->
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="PdfSharpCore" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>

</Project>
