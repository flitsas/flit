# Canal de notificaciones "API Renting cliente" (Features #11347/#11348/#11349)
# Copia a .env.renting (gitignored) o inyéctalas en el contenedor / el ambiente.
# En local, ASP.NET Core NO lee archivos .env: usa User Secrets, appsettings.Development.json
# (gitignored) o variables de entorno del proceso.
#
# NO COMMITEAR VALORES REALES. Los secretos de este archivo van vacíos a propósito.
#
# ---------------------------------------------------------------------------------------------
# LEE ESTO ANTES DE ENCENDER EL CANAL
# ---------------------------------------------------------------------------------------------
# Renting tiene UN SOLO ambiente y es el de PRODUCCIÓN. Los tres .pfx "de pruebas" del
# repositorio del cliente son el MISMO archivo byte a byte: un marcador de posición, no un
# certificado de un ambiente de pruebas. Por eso TODOS nuestros ambientes apuntan al mismo
# endpoint, y por eso el desvío de destinatario es la única barrera que impide que una prueba
# nuestra le llegue a un cliente final real.
#
# ADR-0044 (2026-08-12): el endpoint es el mismo en todas partes, y lo que cambia por DESPLIEGUE
# es el desvío — pero YA NO lo gobierna ASPNETCORE_ENVIRONMENT. Lo gobierna, únicamente, el
# interruptor AFIRMATIVO y PROPIO de este bloque:
#
#   RENTING_API_SEND_EMAIL_REAL_RECIPIENTS_ENABLED ausente/vacía o "false"  ->  desvía (default seguro)
#   RENTING_API_SEND_EMAIL_REAL_RECIPIENTS_ENABLED = "true"                 ->  envía REAL, en CUALQUIER ambiente
#   RENTING_API_SEND_EMAIL_REAL_RECIPIENTS_ENABLED = cualquier otro valor   ->  el arranque FALLA (no degrada en silencio)
#
# Es decir: puede acordarse una ventana de envío real desde DEV o QA (p. ej. una validación
# end-to-end con el cliente) sin tocar ASPNETCORE_ENVIRONMENT. Y al revés: un PDN mal configurado
# puede desviar en silencio (ya no hay una prohibición de arranque que lo impida) — el chequeo es
# el log de arranque y la columna `recipient_diverted` de la bitácora, no un `throw`.
#
# OJO — "ausente/vacía ⇒ desvía" de la fila de arriba es el comportamiento cuando NINGÚN
# appsettings versionado declara esta clave (hoy es el caso). El orden de resolución
# (InfrastructureExtensions.AddRentingChannel, función interna `Cfg`) es: variable de entorno con
# contenido primero, y si viene AUSENTE o VACÍA cae a `IConfiguration` (appsettings.json /
# appsettings.{Environment}.json). Si algún día un appsettings llega a declarar
# `Notifications:Renting:SendEmailRealRecipientsEnabled` en `true`, dejar esta variable de entorno
# VACÍA (p. ej. `${RENTING_API_SEND_EMAIL_REAL_RECIPIENTS_ENABLED:-}` en el compose) NO la anula —
# la neutralización explícita de un valor heredado de configuración es declarar aquí `="false"`,
# nunca dejarla vacía. Ese orden de precedencia es compartido con Rues/Kyverum/Fasecolda y está
# fuera de alcance de esta HU.
#
# El canal nace APAGADO. Con RENTING_API_ENABLED distinto de "true" no se exige ninguna de las
# variables de abajo ni el material TLS, y el servicio arranca con normalidad.
# ---------------------------------------------------------------------------------------------

# Interruptor del canal. Con cualquier valor distinto de "true", se ignora todo lo demás.
RENTING_API_ENABLED=false

# --- Conexión y credenciales (OBLIGATORIAS con el canal encendido) ---------------------------
# Sin cualquiera de estas, el arranque falla con un mensaje que nombra la variable que falta.
RENTING_API_BASE_URL=
RENTING_API_KEY_NAME=Ocp-Apim-Subscription-Key
RENTING_API_KEY_VALUE=
RENTING_API_SECONDS_TIMEOUT=30

# Certificado cliente para mTLS. Ruta ABSOLUTA al .pfx (móntalo como secreto/volumen; NO lo metas
# en la imagen ni en el repositorio). En docker-compose.prod.yml esta misma ruta se usa a los dos
# lados del volumen: el archivo se monta DENTRO del contenedor en la misma ruta que tiene en el
# host, así `ls -l <ruta>` en el VPS comprueba el archivo exacto que la app abrirá.
#
# TRAMPA de Docker: si el archivo no existe en el host, el montaje NO falla — Docker crea un
# DIRECTORIO vacío en esa ruta y lo monta. Sube primero el .pfx; si ya te pasó, borra el directorio
# (rmdir) antes de dejar el archivo y recrea el contenedor.
#
# El certificado se abre en el PRIMER ENVÍO del canal, NO al arrancar (el proveedor cuelga de la
# fábrica de HttpClient, que lo resuelve perezosamente). Es decir: si falta, si la passphrase no
# abre o si el Subject no coincide, el servicio LEVANTA SANO y el fallo aparece al enviar. Un
# arranque limpio no prueba que este canal esté bien configurado — pruébalo desde el banco de
# pruebas de notificaciones.
# VIGENCIA: vence en marzo de 2027. Cuando expire, el canal muere con un error de TLS opaco que
# nadie va a asociar con el correo. Deja la alerta puesta.
RENTING_API_PFX_CERTIFICATE_PATH=
RENTING_API_PASSPHRASE=

# --- Login (obtención del token) -------------------------------------------------------------
RENTING_API_LOGIN_PATH=
RENTING_API_LOGIN_SECONDS_TIMEOUT=30

# NO hay que adivinarlo: mTLS y login comparten la misma identidad, así que este valor debe
# coincidir CARÁCTER A CARÁCTER con el Subject del certificado .pfx de arriba (comparación
# ordinal). Si no coincide, el arranque falla y el mensaje lo dice. Léelo del propio certificado:
#   openssl pkcs12 -in <archivo>.pfx -nokeys -clcerts | openssl x509 -noout -subject
# y respeta el formato que reporta .NET (p. ej. "CN=algo, O=algo, C=CO").
# Al renovar el certificado, este valor casi siempre cambia: actualízalo en el mismo despliegue.
RENTING_API_LOGIN_SUBJECT=

# TRAMPA: esta variable NO se exige al arrancar (su valor por defecto es cadena vacía), pero el
# login la manda en el cuerpo como "secretName". Si la olvidas, el servicio arranca sin quejarse
# y el login falla en caliente con un error de autenticación que no dice que falte nada.
# Es un NOMBRE de secreto que Renting resuelve de su lado, no el secreto en sí.
RENTING_API_LOGIN_SECRET_NAME=

# Caché del token. Opcionales: si no las pones, el TTL por defecto es 3600 s.
RENTING_API_LOGIN_CACHE_KEY=renting-api-login-token
RENTING_API_LOGIN_CACHE_SECONDS_TTL=3600

# --- Envío de correo -------------------------------------------------------------------------
RENTING_API_SEND_EMAIL_PATH=RentingNotification/emailNotification/sendEmailFile
RENTING_API_SEND_EMAIL_SECONDS_TIMEOUT=30

# Remitente con el que sale cada correo enrutado por este canal.
RENTING_API_SEND_EMAIL_SENDER_EMAIL=usadosrc@rentingcolombia.com
RENTING_API_SEND_EMAIL_SENDER_USERNAME=Tramites Renting

# Remitente "por defecto" del bloque de configuración que comparte el proxy del cliente. Hoy no
# lo consume nadie en FLIT; se modela para no divergir del contrato del cliente.
RENTING_API_SEND_EMAIL_DEFAULT_SENDER_EMAIL=tramitesvehiculos@rentingcolombia.com
RENTING_API_SEND_EMAIL_DEFAULT_SENDER_USERNAME=Tramites Vehiculos

# --- Desvío de destinatario (la barrera) -----------------------------------------------------
# ADR-0044. Este interruptor es AFIRMATIVO y PROPIO del DESPLIEGUE: el nombre del ambiente NUNCA
# decide si se desvía. Ausente, vacía o "false" ⇒ desvía (default seguro: todo correo de este
# canal va al buzón de abajo en vez de al destinatario real, y la bitácora marca la fila como
# desviada). "true" (literal) ⇒ envía a destinatarios REALES, en CUALQUIER ambiente — incluido
# DEV o QA, si así se acordó con el cliente. Cualquier otro valor no vacío TUMBA el arranque.
#
# NO declares esta variable con "true" salvo que este despliegue concreto vaya a enviar correo
# real a clientes de Renting (golpea su API PRODUCTIVA); si se hace, debe quedar acordado con el
# cliente y revertirse al cerrar la ventana.
RENTING_API_SEND_EMAIL_REAL_RECIPIENTS_ENABLED=

# DEROGADA (ADR-0044) — NO declares esta variable en ningún despliegue. Su sola presencia con
# valor no vacío, con el canal encendido, tumba el arranque con un mensaje de migración que
# nombra ambas variables (la derogada y RENTING_API_SEND_EMAIL_REAL_RECIPIENTS_ENABLED de arriba).
# RENTING_API_SEND_EMAIL_DEVELOPMENT_RECIPIENT_OVERRIDE_ENABLED=

# ÚNICA EXCEPCIÓN al desvío (decisión del PO, 2026-08-11), aplica en ambos modos de arriba: los
# envíos del BANCO DE PRUEBAS de notificaciones NO se desvían — llegan al buzón de pruebas
# configurado en su pantalla. Ese destinatario no es dato de un cliente, es un correo único que
# un SuperAdmin configuró para esto, así que desviarlo no protegía a nadie y rompía el propósito
# del módulo. La exención es alcanzable solo desde ese camino, nunca desde los envíos reales de
# notificaciones. Efecto lateral a tener presente: si el buzón de pruebas se configura con la
# dirección de una persona real, esa persona recibirá el correo de prueba desde la cuenta de
# Renting en producción.

# Buzón de control. Obligatorio SOLO en modo desvío — el default seguro (si no, el interruptor no
# tendría a dónde desviar y el envío fallaría en silencio en vez de proteger al cliente final).
# En modo envío real puede quedar vacío.
RENTING_API_SEND_EMAIL_DEVELOPMENT_RECIPIENT_EMAIL=notificaciones.renting@gmail.com
RENTING_API_SEND_EMAIL_DEVELOPMENT_RECIPIENT_USERNAME=Equipo de desarrollo FLIT

# ---------------------------------------------------------------------------------------------
# COMILLAS: los valores con espacios van SIN comillas aquí. docker-compose y los archivos .env
# las quitan, pero una variable inyectada directamente (Kubernetes, systemd, App Service) se
# queda con ellas dentro del valor, y el nombre del remitente saldría entrecomillado en el
# correo. Si tu mecanismo de despliegue exige comillas, verifica el valor ya resuelto.
# ---------------------------------------------------------------------------------------------
