{
  "ConnectionStrings": {
    "Core": "Host=localhost;Port=5432;Database=flitdev;Username=postgres;Password=root"
  },
  "Database": {
    "AutoMigrate": true
  },
  "IctJwt": {
    "Issuer": "https://ict.flit.co",
    "Audience": "flit-ict",
    "TokenLifetimeHours": 2,
    "PrivateKeyPem": "",
    "PrivateKeyPath": ""
  },
  "CoreApiGrpc": {
    "Address": "http://localhost:4021"
  },
  "FileManager": {
    "BaseUrl": "https://devfilemanager.flitsas.online/",
    "FilesPath": "api/v1/files",
    "Category": "ict"
  },
  "Ingest": {
    "MaxItemsPerBatch": 20,
    "RelaxRegisterCommitDurability": false
  },
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
