<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Epic #13316 (ADR-0065, ADR-0070, contrato de plataforma v1.3 §6.1) — contrato gRPC de Consultas
    (flit.consultas.v1), generado desde contracts/proto. Cliente y servidor (Both): core-consultas atiende;
    Trámites, ICT y los productos llaman. Los tipos de flit.platform.v1 vienen de Flit.Platform.Grpc.Contracts.
    Ver la nota sobre el contexto de Docker en contracts/proto/README.md.
  -->

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Flit.Consultas.Grpc.V1</RootNamespace>
    <ProtoRoot>..\..\..\..\contracts\proto</ProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(ProtoRoot)\flit\consultas\v1\*.proto" ProtoRoot="$(ProtoRoot)" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\core-identity\src\Flit.Platform.Grpc.Contracts\Flit.Platform.Grpc.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Net.ClientFactory" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Tools">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
