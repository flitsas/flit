<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pruebas de core-diagnostico (HU #13721, F00.1-H1): arranque con migraciones en el esquema propio, salud REST y gRPC,
    autenticación del SDK y configuración. Program.Build real sobre un Postgres efímero (ConnectionStrings__Core).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Flit.Diagnostico.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flit.Diagnostico.Api\Flit.Diagnostico.Api.csproj" />
    <ProjectReference Include="..\..\src\Flit.Diagnostico.Domain\Flit.Diagnostico.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- Tabla única de casos de identificadores (HU #13740); la comparte el frontend (HU #13745). -->
  <ItemGroup>
    <None Include="..\..\..\..\contracts\fixtures\validacion\identificadores-vehiculo.json" Link="Fixtures\identificadores-vehiculo.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Fixtures de contrato del bus (ADR-0075, HU #13727): los mismos que valida core-consultas. -->
  <ItemGroup>
    <None Include="..\..\..\..\contracts\fixtures\bus\*.v1.json" Link="Fixtures\bus\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Archivos de carga inventados (HU #13749): .xlsx, .csv, .xls, .pdf y un .xlsx dañado. -->
  <ItemGroup>
    <None Include="Api\Fixtures\carga*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
