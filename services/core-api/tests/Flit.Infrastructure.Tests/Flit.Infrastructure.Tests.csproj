<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Flit.Infrastructure.Tests</RootNamespace>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flit.Infrastructure\Flit.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Flit.Tramites.Application\Flit.Tramites.Application.csproj" />
    <ProjectReference Include="..\..\src\Flit.Tramites.Domain\Flit.Tramites.Domain.csproj" />
    <!-- Reportes2 HU-A — tests de integración del endpoint batch de telemetría (WebApplicationFactory). -->
    <ProjectReference Include="..\..\src\Flit.Api\Flit.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      HU #11350 — regla de comparación de los golden de correo, ENLAZADA (no copiada) para que no
      se bifurque entre este proyecto y el de Security.Application.Tests.
    -->
    <Compile Include="..\Shared\EmailGolden.cs" Link="Shared\EmailGolden.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Golden de asunto y cuerpo de las plantillas de correo de Analítica: la salida EXACTA que la
      plataforma producía ANTES de extraer la composición (HU #11351/#11352).

      Un REFACTOR nunca debe obligar a editarlos. Si al mover código un golden empieza a fallar,
      lo que está mal es el refactor. Solo un cambio DELIBERADO del correo justifica regenerarlos,
      con GOLDEN_UPDATE=1 y en un commit aparte que diga por qué — si no, cualquiera puede tapar
      una regresión reescribiendo la prueba y llamándolo "actualizar el golden".
    -->
    <None Update="Fixtures/Email/*.golden.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="NSubstitute" />
    <!-- Reportes2 HU-A — host de pruebas + JWT dummy del endpoint de telemetría. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
  </ItemGroup>

</Project>
