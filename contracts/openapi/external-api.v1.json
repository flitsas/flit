                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "externalClient": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Pase de acceso externo: JWT RS256 con emisor flit-core-external y audiencia flit-external, obtenido en POST /api/v1/external/auth/token. No sirve el pase de un usuario de la plataforma. Permisos: external.tramites.read (feed y factura) y external.tramites.pii.read (datos personales en claro)."
      }
    },
    "headers": {
      "RetryAfter": {
        "description": "Segundos a esperar antes de reintentar.",
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "description": "Error RFC 7807 (application/problem+json) con el código estable en la extensión code.",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Siempre about:blank."
          },
          "title": {
            "type": "string",
            "description": "Igual a code."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "Código HTTP."
          },
          "detail": {
            "type": "string",
            "description": "Explicación legible. No usar para decidir: usar code."
          },
          "code": {
            "type": "string",
            "description": "Código estable del error.",
            "enum": [
              "invalid_client",
              "client_locked",
              "secret_rotation_required",
              "external_auth_unavailable",
              "invalid_token",
              "insufficient_scope",
              "invalid_cursor",
              "invalid_page_size",
              "invalid_since",
              "cursor_and_since_exclusive",
              "attachment_not_found",
              "storage_unavailable",
              "rate_limited"
            ]
          }
        }
      },
      "TokenRequest": {
        "type": "object",
        "description": "Canje de credenciales por un pase de acceso.",
        "required": [
          "clientId",
          "clientSecret"
        ],
        "properties": {
          "clientId": {
            "type": "string",
            "description": "Identificador del cliente de integración (p. ej. flito-qa)."
          },
          "clientSecret": {
            "type": "string",
            "format": "password",
            "description": "Secreto entregado fuera de banda al dar de alta el cliente."
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "description": "Pase de acceso externo.",
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "scope"
        ],
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Pase JWT RS256 de este emisor (no es un pase de la plataforma)."
          },
          "tokenType": {
            "type": "string",
            "description": "Siempre Bearer.",
            "enum": [
              "Bearer"
            ]
          },
          "expiresIn": {
            "type": "integer",
            "format": "int32",
            "description": "Vigencia en segundos (1800). Renovar antes de que venza o ante un 401."
          },
          "scope": {
            "type": "array",
            "description": "Permisos del pase.",
            "items": {
              "type": "string",
              "enum": [
                "external.tramites.read",
                "external.tramites.pii.read"
              ]
            }
          }
        }
      },
      "SyncPage": {
        "type": "object",
        "description": "Página del feed de sincronización (contrato v3.1 §3).",
        "required": [
          "items",
          "nextCursor",
          "hasMore",
          "pageSize",
          "serverTime"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "Ítems en el orden del cursor. Vacío si no hubo cambios (nunca 404).",
            "items": {
              "$ref": "#/components/schemas/TramiteItem"
            }
          },
          "nextCursor": {
            "type": "string",
            "description": "Cursor opaco. Siempre presente: persistirlo tras aplicar la página y continuar desde ahí."
          },
          "hasMore": {
            "type": "boolean",
            "description": "true si hay otra página disponible ya."
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "description": "Tamaño de página aplicado."
          },
          "serverTime": {
            "type": "string",
            "format": "date-time",
            "description": "Hora del servidor. Fecha y hora con desfase de Colombia (-05:00)."
          }
        }
      },
      "TramiteItem": {
        "type": "object",
        "description": "Trámite del feed (contrato v3.1 §4). Todas las claves van siempre presentes; el dato ausente es null.",
        "required": [
          "id",
          "radicado",
          "consecutivo",
          "syncVersion",
          "fechaUltimoCambio",
          "eliminado",
          "estado",
          "tramite",
          "fechaCreacion",
          "fechaRadicacion",
          "fechaAprobacion",
          "vehiculo",
          "organismo",
          "compradores",
          "factura",
          "companiaGestora"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Identificador estable del trámite. Clave de upsert."
          },
          "radicado": {
            "type": "string",
            "description": "Radicado FLIT, formato FTn-NNNNNNN. Único e inmutable."
          },
          "consecutivo": {
            "type": "integer",
            "format": "int64",
            "description": "Consecutivo numérico global."
          },
          "syncVersion": {
            "type": "integer",
            "format": "int64",
            "description": "Versión de sincronización, creciente por trámite. Descartar si es ≤ a la guardada."
          },
          "fechaUltimoCambio": {
            "type": "string",
            "format": "date-time",
            "description": "Último cambio del trámite o de sus datos relacionados. Fecha y hora con desfase de Colombia (-05:00)."
          },
          "eliminado": {
            "type": "boolean",
            "description": "true = tombstone: vehiculo, organismo y factura en null y compradores en []."
          },
          "estado": {
            "type": "string",
            "description": "Código interno en minúscula.",
            "enum": [
              "borrador",
              "preparado",
              "preasignacion",
              "asignado",
              "entregado",
              "aprobado",
              "rechazado",
              "anulado",
              "revocado"
            ]
          },
          "tramite": {
            "$ref": "#/components/schemas/TipoTramite"
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora con desfase de Colombia (-05:00)."
          },
          "fechaRadicacion": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Fecha y hora con desfase de Colombia (-05:00)."
          },
          "fechaAprobacion": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Última transición a aprobado. Fecha y hora con desfase de Colombia (-05:00)."
          },
          "vehiculo": {
            "$ref": "#/components/schemas/Vehiculo"
          },
          "organismo": {
            "$ref": "#/components/schemas/Organismo"
          },
          "compradores": {
            "type": "array",
            "maxItems": 4,
            "description": "Compradores (o, si no hay, propietarios) por ordinal. Nunca null; puede venir vacío.",
            "items": {
              "$ref": "#/components/schemas/Comprador"
            }
          },
          "factura": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Factura"
              }
            ],
            "description": "Factura más reciente. Descarga vía la URL firmada."
          },
          "companiaGestora": {
            "$ref": "#/components/schemas/CompaniaGestora"
          }
        }
      },
      "TipoTramite": {
        "type": "object",
        "description": "Tipo de trámite.",
        "required": [
          "codigo",
          "nombre",
          "familia"
        ],
        "properties": {
          "codigo": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "familia": {
            "type": "string",
            "nullable": true,
            "description": "MATRICULAS | TRASPASO | OTROS."
          }
        }
      },
      "Vehiculo": {
        "type": "object",
        "description": "Datos del vehículo. Puede ser null.",
        "required": [
          "vin",
          "placa",
          "clase",
          "marca",
          "linea",
          "modeloAno",
          "carroceria",
          "cilindraje",
          "cilindrajeTexto",
          "capacidad",
          "numeroMotor",
          "numeroSerie",
          "tipoServicio"
        ],
        "properties": {
          "vin": {
            "type": "string",
            "nullable": true
          },
          "placa": {
            "type": "string",
            "nullable": true
          },
          "clase": {
            "type": "string",
            "nullable": true
          },
          "marca": {
            "type": "string",
            "nullable": true
          },
          "linea": {
            "type": "string",
            "nullable": true,
            "description": "Equivale al «modelo» comercial."
          },
          "modeloAno": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "Año modelo."
          },
          "carroceria": {
            "type": "string",
            "nullable": true
          },
          "cilindraje": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "null si el origen no es numérico (el texto va en cilindrajeTexto)."
          },
          "cilindrajeTexto": {
            "type": "string",
            "nullable": true
          },
          "capacidad": {
            "type": "integer",
            "format": "int32",
            "nullable": true,
            "description": "Pasajeros."
          },
          "numeroMotor": {
            "type": "string",
            "nullable": true
          },
          "numeroSerie": {
            "type": "string",
            "nullable": true
          },
          "tipoServicio": {
            "$ref": "#/components/schemas/TipoServicio"
          }
        },
        "nullable": true
      },
      "TipoServicio": {
        "type": "object",
        "description": "Tipo de servicio normalizado. Puede ser null.",
        "required": [
          "codigo",
          "nombre"
        ],
        "properties": {
          "codigo": {
            "type": "string",
            "description": "PARTICULAR, PUBLICO, …"
          },
          "nombre": {
            "type": "string",
            "nullable": true
          }
        },
        "nullable": true
      },
      "Organismo": {
        "type": "object",
        "description": "Organismo de tránsito. Puede ser null.",
        "required": [
          "codigoTransito",
          "nombre",
          "codigoSecretaria",
          "ciudad",
          "departamento"
        ],
        "properties": {
          "codigoTransito": {
            "type": "string",
            "nullable": true,
            "description": "Código RUNT del organismo (8 dígitos)."
          },
          "nombre": {
            "type": "string",
            "nullable": true
          },
          "codigoSecretaria": {
            "type": "string",
            "nullable": true,
            "description": "Código DIVIPOLA del municipio."
          },
          "ciudad": {
            "type": "string",
            "nullable": true
          },
          "departamento": {
            "type": "string",
            "nullable": true
          }
        },
        "nullable": true
      },
      "Comprador": {
        "type": "object",
        "description": "Comprador o propietario. Un null sigue siendo null al enmascarar.",
        "required": [
          "ordinal",
          "porcentajeParticipacion",
          "rolActor",
          "tipoPersona",
          "tipoDocumento",
          "numeroDocumento",
          "nombreCompleto",
          "direccion",
          "ciudad",
          "celular",
          "correo"
        ],
        "properties": {
          "ordinal": {
            "type": "integer",
            "format": "int32",
            "description": "1 = principal; 2..4 = copropietarios."
          },
          "porcentajeParticipacion": {
            "type": "number",
            "format": "decimal",
            "nullable": true,
            "description": "Porcentaje de propiedad (2 decimales). null con un solo comprador."
          },
          "rolActor": {
            "type": "string",
            "enum": [
              "comprador",
              "propietario"
            ]
          },
          "tipoPersona": {
            "type": "string",
            "nullable": true,
            "description": "natural | juridical."
          },
          "tipoDocumento": {
            "type": "string",
            "nullable": true,
            "description": "CC, NIT, CE, PAS, TI, …"
          },
          "numeroDocumento": {
            "type": "string",
            "nullable": true,
            "x-pii": "alta",
            "description": "Dato personal (alta). Sin external.tramites.pii.read llega enmascarado: primer carácter y últimos 4 (9****0000)."
          },
          "nombreCompleto": {
            "type": "string",
            "nullable": true,
            "description": "En persona jurídica, la razón social. Dato personal (media). Sin external.tramites.pii.read llega enmascarado: inicial de cada palabra (P*** E***).",
            "x-pii": "media"
          },
          "direccion": {
            "type": "string",
            "nullable": true,
            "x-pii": "alta",
            "description": "Dato personal (alta). Sin external.tramites.pii.read llega enmascarado: oculta (***)."
          },
          "ciudad": {
            "type": "string",
            "nullable": true
          },
          "celular": {
            "type": "string",
            "nullable": true,
            "x-pii": "media",
            "description": "Dato personal (media). Sin external.tramites.pii.read llega enmascarado: últimos 4 (******0000)."
          },
          "correo": {
            "type": "string",
            "nullable": true,
            "x-pii": "alta",
            "description": "Dato personal (alta). Sin external.tramites.pii.read llega enmascarado: primera letra y dominio (c***@ejemplo.test)."
          }
        }
      },
      "Factura": {
        "type": "object",
        "description": "Factura del trámite. Puede ser null.",
        "required": [
          "adjuntoId",
          "nombreArchivo",
          "cargadaEn"
        ],
        "properties": {
          "adjuntoId": {
            "type": "string",
            "format": "uuid",
            "description": "Usar en GET /api/v1/external/tramites/{id}/adjuntos/{adjuntoId}/url."
          },
          "nombreArchivo": {
            "type": "string",
            "nullable": true
          },
          "cargadaEn": {
            "type": "string",
            "format": "date-time",
            "description": "Fecha y hora con desfase de Colombia (-05:00)."
          }
        },
        "nullable": true
      },
      "CompaniaGestora": {
        "type": "object",
        "description": "Compañía que radicó el trámite.",
        "required": [
          "tenantId",
          "nit",
          "nombre"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "nit": {
            "type": "string",
            "nullable": true
          },
          "nombre": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AdjuntoUrl": {
        "type": "object",
        "description": "URL firmada de descarga de la factura.",
        "required": [
          "url",
          "expiraEn",
          "nombreArchivo",
          "contentType"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "URL firmada de un solo uso inmediato (10 minutos). Descargar sin cabeceras de autorización."
          },
          "expiraEn": {
            "type": "string",
            "format": "date-time",
            "description": "Informativo. Fecha y hora con desfase de Colombia (-05:00)."
          },
          "nombreArchivo": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          }
        }
      }
    }
  }
}
